# Copy to /root/.config/mw/seat.env (or wherever %h resolves for the host
# running mw-seat-tmux.service — /root for the system manager). Read by
# contrib/systemd/system/mw-seat-tmux.service; without it the unit's tmux
# runs with a bare PATH, and the seat scripts running inside the server it
# starts may not find mw, bd, git, tmux, claude or go. One line:
PATH=/root/.local/bin:/root/go/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
