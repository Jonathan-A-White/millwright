# Runs mw-millhand-tick.service at 7 minutes past every hour: the heartbeat. For
# `systemctl --user`; see README.md, "Waking the Millhand".
#
# On the home, the event follower (mw-view-follow.service) runs this same
# service on an alarm, mail for the Millhand or a failed doctor, so the hour is
# only the fallback for an event it missed (mw-jrx0s.14).
#
# The minute is off the dispatch timer's (0) and the health timer's (0, 15, 30,
# 45), so they do not start together. The cadence is a fuel knob: change it
# with a drop-in (`systemctl --user edit mw-millhand-tick.timer`: `OnCalendar=`
# then `OnCalendar=*:7/15` for the old pace on a host with no follower), never
# by editing this file.
[Unit]
Description=Hourly heartbeat: wake the Millhand if something needs it (mw millhand tick)

[Timer]
OnCalendar=*:07
# No catch-up: a host that was asleep or off does not run the ticks it missed,
# and it is not woken to run them. The next tick on the clock is the next run.
Persistent=false
WakeSystem=false
AccuracySec=30s

[Install]
WantedBy=timers.target
