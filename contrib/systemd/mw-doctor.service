# One `mw doctor` run, as the user, then it exits: no daemon. For
# `systemctl --user`; see README.md, "mw doctor".
#
# Started by mw-doctor.timer. It works a table of checks, each its own probe
# and cure, offline and without AI, and logs what it found on this host. It
# sends no mail itself, but a check left needing a person is a beads note and
# the alarms are pushed through the tracker, so its bd needs beads.env too.
[Unit]
Description=Cure this host's known faults offline, on a table of checks (mw doctor)
OnFailure=mw-unit-failed@%n.service

[Service]
Type=oneshot

# Unlike the rig's other units this does not rely on PATH to find mw: doctor's
# job is to work even when this host's own environment is suspect, so it runs
# the binary at its one fixed, known place. `env` only saves `systemd-analyze
# verify` from having to resolve %h itself; it does no PATH lookup on a path
# holding a "/".
EnvironmentFile=-%h/.config/mw/dispatch.env
# bd reaches a served beads database through BEADS_DOLT_* in beads.env; without
# them it makes .beads/embeddeddolt and finds nothing (mw-gq6.446). Optional, as
# a host whose beads are embedded has none.
EnvironmentFile=-%h/.config/mw/beads.env
ExecStart=/usr/bin/env %h/.local/bin/mw doctor

# mw doctor leaves with 6 (application.DoctorFaultExit) when a check is left
# faulty and uncured: "somebody should look", an outcome and not a failure, and
# the report naming it is already in the journal. systemd counts any other
# non-zero status as failed, and OnFailure= would then mail the Mayor on every
# 5-minute run while the fault lasts (mw-gq6.532).
SuccessExitStatus=6

# Type=oneshot has no start timeout by default, and a hung systemctl would
# then block every later run.
TimeoutStartSec=2min

# A run starts no tmux server (its cures never start one), so a memory squeeze
# may kill it first, before the seat or the blog it shares the host with: make
# the kernel's OOM killer pick it first, and cap what it may use.
OOMScoreAdjust=500
MemoryMax=384M
