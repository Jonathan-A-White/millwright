# Runs mw-postern-mirror.service at 3, 13, 23, ... minutes past every hour. For
# `systemctl --user`; see README.md, "mw postern mirror".
#
# The minutes are off the dispatch, doctor and Millhand ticks', so none starts
# with another. Every host may arm it: a host that is not home does nothing. The
# ten minutes are how much of the postern's data a dead home can lose; change
# them with a drop-in (`systemctl --user edit mw-postern-mirror.timer`), never
# by editing this file.
[Unit]
Description=Every 10 minutes, the home copies the postern's data to the boost (mw postern mirror)

[Timer]
OnCalendar=*:3/10
# No catch-up: a host that was asleep or off does not run the copies it missed,
# and it is not woken to run them. The next tick on the clock is the next run.
Persistent=false
WakeSystem=false
AccuracySec=30s

[Install]
WantedBy=timers.target
