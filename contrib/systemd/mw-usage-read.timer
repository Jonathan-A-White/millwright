# Runs mw-usage-read.service at 4 and 34 minutes past every hour. For
# `systemctl --user`; see docs/fuel-knobs.md.
#
# The minutes are off the dispatch timer's (0, 5, 10, ...) and the doctor's
# (2, 7, 12, ...) so the three never start together. The cadence is a fuel knob:
# change it with a drop-in (`systemctl --user edit mw-usage-read.timer`), never
# by editing this file.
[Unit]
Description=Every 30 minutes, read the quota off Claude's /usage screen (mw usage read)

[Timer]
OnCalendar=*:4/30
# No catch-up: a host that was asleep or off does not read for the runs it
# missed, and it is not woken to read. The next tick on the clock is the next
# read.
Persistent=false
WakeSystem=false
AccuracySec=30s

[Install]
WantedBy=timers.target
