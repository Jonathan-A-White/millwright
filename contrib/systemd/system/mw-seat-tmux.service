# Makes sure a tmux server with a session named "0" exists on this host's
# default socket, and sets it up so the kernel spares it under memory
# pressure. A system unit (root), for hosts whose seats run as root; see
# README.md, "The seat's tmux server on the VPS". A host whose seats run as a
# person instead needs no unit for this: their login starts the server.
#
# Why a system unit and not `systemctl --user`: the VPS's tmux server used to
# live under root's user manager (user-0.slice). When the OOM killer took the
# manager, systemd killed everything under it, the Mayor's session included —
# and with nobody logging in, nothing would have restarted it. A system unit
# answers to no user manager, so it cannot be taken down with one.
[Unit]
Description=Keep a tmux server up for this host's seats (session 0)
After=network.target

# The one process everything else on this host depends on must keep trying:
# systemd's default (5 restarts inside 10s) is close enough to RestartSec=2's
# own cadence below that a server dying repeatedly could exhaust it and leave
# the unit "failed" -- exactly the silence this fix exists to close, in a new
# shape. No limit at all.
StartLimitIntervalSec=0

[Service]
# Type=forking used to sit here: ExecStart's `has-session || new-session`
# forks a new tmux server only in the branch where none existed yet. When one
# already did (a login, or an earlier run of this unit), `has-session`
# succeeded and the whole command exited straight away without forking
# anything into this unit's cgroup -- systemd saw its tracked process gone
# a moment after it started, and with Restart=always/RestartSec=2 restarted
# it forever, every 2s, with the found session never touched (mw-gq6.111:
# reproduced live 2026-09-25 against a session the unit did not create).
# Type=simple fixes this by tracking ExecStart's own process, not a forked
# child: see the loop below.
Type=simple

# RemainAfterExit=yes used to sit here instead of Restart=: it kept the unit
# "active (exited)" once its tracked process (the tmux server) was gone,
# rather than dead, but that also swallows a restart -- systemd never treats
# an already-"active" unit as one to restart, so a server that died (all of
# 02:48Z 2026-09-25's panes exited, or a plain `tmux kill-server`) left the
# unit reporting active with nothing behind it, and the next thing that
# needed the seat's session landed in a login scope instead. Restart=always
# is what notices: a clean tmux exit (what `tmux kill-server` causes) is not
# a "failure", so Restart=on-failure alone would not have caught it either.
Restart=always
RestartSec=2

# A system unit gets a bare PATH. The host says where tmux and the rest of a
# seat's tools live in this file; the leading "-" makes it optional, since a
# server already up needs nothing from it.
EnvironmentFile=-%h/.config/mw/seat.env

# has-session first, so a server a login (or an earlier run of this unit)
# already started is left exactly as it is: this never restarts or replaces
# a running server, and starting one is a no-op once one exists. Either way,
# the `while` loop that follows is what this unit's Type=simple then tracks
# as its one process: it polls has-session and sleeps for as long as session
# 0 stays up, whether this unit started it or only found it. Only when the
# session goes away does the loop's condition fail and the process exit,
# which is what gives Restart=always something to notice and act on.
ExecStart=/bin/sh -c 'tmux has-session -t =0 2>/dev/null || tmux new-session -d -s 0; while tmux has-session -t =0 2>/dev/null; do sleep 1; done'

# Stopping or restarting this unit must never kill the server: the sessions
# inside it (the Mayor's, a Builder's) are not this unit's to end.
ExecStop=/bin/true
KillMode=process

# The one process everything else on this host depends on: make the kernel's
# OOM killer pick almost anything else before this. `oom_score_adj` is
# inherited across tmux's own fork, so the server this starts carries it too;
# a server a login already started keeps whatever score it was given then.
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
