# Inputs for contrib/boost-bootstrap.sh: copy to a file only you can read
# (chmod 600), fill in the blanks, and run
#   contrib/boost-bootstrap.sh --env-file that-file
# The same names may be set in the environment instead, and then win over this
# file. Each line is NAME=VALUE; a value with spaces goes in double quotes.
# The tokens below are passed in, never fetched: leave a blank blank. Delete the
# file when the run is done. docs/boost-bootstrap.md says what each is for.

# --- required ---
# This host's name in the factory (the host = line of its config.toml).
BOOST_HOST=cloud1
# Its address on the WireGuard network: the next free 10.88.0.x (no mask).
BOOST_WG_ADDRESS=10.88.0.4
# The hub's public key (the VPS's /etc/wireguard/vps.pub).
BOOST_WG_HUB_PUBKEY=
# The home's address on WireGuard, where its beads server (Dolt) listens.
BOOST_BEADS_HOST=10.88.0.2

# --- optional ---
# This host's WireGuard private key. Blank: the script makes one, keeps it in
# wg0.conf, and prints the public key for `wg-enrol` on the hub.
BOOST_WG_PRIVATE_KEY=
# The hub's public endpoint. Blank: the one wg-enrol uses.
BOOST_WG_ENDPOINT=
# The beads server's port, user and password. Blank: 3307, bd's default user, none.
BOOST_BEADS_PORT=
BOOST_BEADS_USER=
BOOST_BEADS_PASSWORD=
# The rigs to clone, as name=git-url, space separated. millwright itself is always there.
BOOST_RIGS="argus=https://github.com/Jonathan-A-White/argus.git postern=https://github.com/Jonathan-A-White/postern.git"
# Where the rigs go (default: your home directory), and the vault's checkout and url.
BOOST_RIGS_DIR=
BOOST_VAULT=
BOOST_VAULT_REPO=
# How many Builder sessions may run here at once (default 2).
BOOST_CAP=
# A GitHub token that can read the vault and the rigs (a fine-grained, read-only one).
BOOST_GITHUB_TOKEN=
# A Claude Code token, from `claude setup-token` on a machine you are logged in on.
BOOST_CLAUDE_TOKEN=
# The git identity commits are made under.
BOOST_GIT_NAME=
BOOST_GIT_EMAIL=
# The Node version to install when Node 22 or newer is not there (default 24.21.0).
BOOST_NODE_VERSION=
# Where the millwright rig is cloned when this script is not run from inside it.
MW_HOME=
