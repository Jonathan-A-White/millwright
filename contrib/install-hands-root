#!/bin/sh
# install-hands-root — let this host run the Governor's approved root steps.
#
#   sudo ~/millwright/contrib/install-hands-root <user> [<governor public key hex>] [--yes]
#
# Run once, by the Governor's own hands, on each host that should run root
# hands steps (postern's docs/protocol.md section 17). It installs:
#
#   /usr/local/sbin/mw-hands-root   root:root 0755  bin/mw-hands-root of this rig
#   /etc/mw-hands/governor.pub      root:root 0644  the Governor's public key
#   /etc/mw-hands/host              root:root 0644  this host's name in the factory
#   /etc/sudoers.d/mw-hands         root:root 0440  <user> ALL=(root) NOPASSWD: /usr/local/sbin/mw-hands-root
#
# and makes /var/lib/mw-hands (0700), where mw-hands-root records every
# approval it has run. mw, as <user>, then hands a root step to
# `sudo -n /usr/local/sbin/mw-hands-root`, which checks the Governor's
# signature itself against /etc/mw-hands/governor.pub, and that the step is
# for this host, before it runs anything: <user> can run nothing as root
# without his signature.
#
# The key, when not given, is `postern_governor_key` in <user>'s mw config
# (~/.config/mw/config.toml, root table), and the host is `host` there; the
# home directory is <user>'s from the password database, never $HOME. It
# shows the key and its fingerprint and asks before writing anything; --yes
# skips the question. The sudoers file is checked with visudo -cf before it
# is moved into place. Re-running replaces the same files and keeps the
# record of approvals already run. It prints the way back.
#
# MW_HANDS_INSTALL_PREFIX, for this rig's own test only, puts every file
# under another directory; the sudoers line still names the real path, and
# sudo's own environment reset keeps it from a real run.
set -eu

die() { echo "install-hands-root: $*" >&2; exit 1; }

yes=0
user=
key=
for arg in "$@"; do
	case $arg in
	--yes) yes=1 ;;
	-*) die "unknown option $arg" ;;
	*)
		if [ -z "$user" ]; then user=$arg
		elif [ -z "$key" ]; then key=$arg
		else die "usage: install-hands-root <user> [<governor public key hex>] [--yes]"
		fi ;;
	esac
done
[ -n "$user" ] || die "usage: install-hands-root <user> [<governor public key hex>] [--yes]"

[ "$(id -u)" = 0 ] || die "run it as root: sudo $0 $*"

rig=$(cd "$(dirname "$0")/.." && pwd)
helper="$rig/bin/mw-hands-root"
[ -f "$helper" ] && [ -x "$helper" ] || die "mw-hands-root is not built: run make -C $rig build, then this again"

case $user in
root) die "name the user mw runs as, not root" ;;
*[!A-Za-z0-9_.-]* | [!A-Za-z_]*) die "$user is not a user name" ;;
esac
entry=$(getent passwd "$user") || die "there is no user $user"
home=$(printf '%s\n' "$entry" | cut -d: -f6)
[ -n "$home" ] || die "the user $user has no home directory"
config="$home/.config/mw/config.toml"

# rootkey reads one root-table key of mw's config: the part of the file
# before its first [table], the value unquoted, or up to a # comment.
rootkey() {
	[ -r "$config" ] || return 0
	value=$(sed -n '/^[[:space:]]*\[/q; s/^[[:space:]]*'"$1"'[[:space:]]*=[[:space:]]*//p' "$config" | head -n 1)
	case $value in
	\"*) value=${value#\"}; value=${value%%\"*} ;;
	\'*) value=${value#\'}; value=${value%%\'*} ;;
	*) value=${value%%#*}; value=${value%"${value##*[![:space:]]}"} ;;
	esac
	printf '%s' "$value"
}

if [ -z "$key" ]; then
	key=$(rootkey postern_governor_key)
	[ -n "$key" ] || die "no postern_governor_key in $config: give the Governor's public key as the second argument"
fi
key=$(printf '%s' "$key" | tr 'A-F' 'a-f')
printf '%s' "$key" | grep -Eq '^0[23][0-9a-f]{64}$' || die "$key is not a compressed public key: 66 hex characters starting 02 or 03"
host=$(rootkey host)
[ -n "$host" ] || die "no host in $config: mw's own host = \"...\" names this host"
printf '%s' "$host" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' || die "the host $host in $config is not a host name"

fingerprint=$(printf '%s' "$key" | sha256sum | cut -c1-16 | sed 's/..../& /g; s/ $//')
prefix=${MW_HANDS_INSTALL_PREFIX:-}
sbin="$prefix/usr/local/sbin"
etc="$prefix/etc/mw-hands"
sudoers="$prefix/etc/sudoers.d"
used="$prefix/var/lib/mw-hands"
line="$user ALL=(root) NOPASSWD: /usr/local/sbin/mw-hands-root"

cat <<EOF
This lets $user on $host run the Governor's approved root steps:

  Governor's key  $key
  fingerprint     sha256 $fingerprint
  host            $host
  sudoers         $line

It writes $sbin/mw-hands-root, $etc/governor.pub, $etc/host
and $sudoers/mw-hands, and keeps $used.
EOF
if [ "$yes" != 1 ]; then
	printf 'Install? [y/N] '
	read -r answer || answer=
	case $answer in
	y | Y | yes | YES) ;;
	*) echo "Nothing written."; exit 1 ;;
	esac
fi

# The sudoers file first, checked before anything is written: sudo never
# reads a file in sudoers.d whose name holds a dot, so the check's copy is
# never live.
mkdir -p "$sudoers"
check="$sudoers/.mw-hands.new"
trap 'rm -f "$check"' EXIT
printf '%s\n' "$line" >"$check"
chmod 0440 "$check"
visudo -cf "$check" >/dev/null || die "visudo refused the sudoers line; nothing written"

# place writes $1's content to $2, mode $3, root's, in one move.
place() {
	cp "$1" "$2.new"
	chmod "$3" "$2.new"
	chown root:root "$2.new"
	mv -f "$2.new" "$2"
}

mkdir -p "$sbin" "$etc"
chmod 0755 "$etc"
chown root:root "$etc"
place "$helper" "$sbin/mw-hands-root" 0755
printf '%s\n' "$key" >"$etc/.governor.pub"
place "$etc/.governor.pub" "$etc/governor.pub" 0644
rm -f "$etc/.governor.pub"
printf '%s\n' "$host" >"$etc/.host"
place "$etc/.host" "$etc/host" 0644
rm -f "$etc/.host"
mkdir -p "$used"
chmod 0700 "$used"
chown root:root "$used"
chown root:root "$check"
mv -f "$check" "$sudoers/mw-hands"
trap - EXIT

cat <<EOF
Installed. $user can now run root steps the Governor approves, on $host.

The way back:
  sudo rm -f $sudoers/mw-hands $sbin/mw-hands-root
  sudo rm -rf $etc
  sudo rm -rf $used   # the record of approvals already run
EOF
