#!/bin/sh
# Retired: the wait a seat arms for its mail is `mw events wait` now, which
# blocks on the home's event log (a look at its head once a second, no bd, no
# sync, no tokens) instead of polling the inbox every 30 seconds, and is told
# of the mail the moment mw events follow writes it. This script says so and
# runs it, so a seat whose standing instructions still say mail-wait keeps
# working: the seat is MW_MAIL_MAILBOX (mayor), the limit is MW_MAIL_WAIT_LIMIT
# seconds when set (3000, 50m, otherwise), and any arguments are passed on to
# `mw events wait`. Without --kinds the kinds are those of the seat's
# seats/<seat>/subscribe.toml in the vault, or mail alone when it has none.
# Arm it in the background and arm it again each time it ends, as before.
#
# The mail-notify timer still types the mail line into the Mayor's window on a
# host where mw events follow is not running (see README.md, "Telling the
# Mayor's window when mail arrives"), and defers to the follower where it is.

set -u

echo "retired: mw events wait"
case ${MW_MAIL_WAIT_LIMIT:-} in
'' | *[!0-9]*) exec mw events wait --for "${MW_MAIL_MAILBOX:-mayor}" "$@" ;;
*) exec mw events wait --for "${MW_MAIL_MAILBOX:-mayor}" --limit "${MW_MAIL_WAIT_LIMIT}s" "$@" ;;
esac
