#!/bin/sh
# Tell the live Mayor's tmux window, in one typed line, that mail has arrived,
# and, when the quiet alarm has something to say, a second: that a claimed
# story has run long with nothing mailed about it, or another host's last
# sync has gone stale. Run by mw-mail-notify.timer, once a tick (see
# README.md, "Telling the Mayor's window when mail arrives"); safe to run by
# hand. Zero tokens: it reads files, `mw nudge`'s own zero-token read, and the
# tmux screen, and types nothing but the two fixed-shape lines below.
#
# Each tick:
#   1. skips everything if the 1-minute load average is above a limit (the
#      host's core count unless MW_MAIL_LOAD_LIMIT says otherwise), except
#      the view of step 6: a tick skipped for load still publishes it when the
#      beads have changed and the last view is at least MW_MAIL_VIEW_MAX_AGE
#      seconds old (default 300), and says so in its log line. Nothing else
#      runs, and no mail line is typed (mw-gq6.150);
#   2. runs `mw sync`, at nice 19 and idle I/O priority, if the last sync was
#      MW_MAIL_SYNC_EVERY seconds ago or more (default 300, five minutes);
#   3. lists `bd mail inbox` for the mailbox and compares its ids with the ids
#      it has already announced;
#   4. when this host has a postern key file, runs `mw postern inbox
#      --unread-count` and compares it with the count last noted: above zero
#      and higher than that is something to type, same count or fewer is not,
#      and a fall is noted at once as the count last noted (mw-gq6.133);
#   5. runs `mw nudge`, which reuses that same synced beads, for the quiet
#      alarm's clauses, and drops any whose condition already fired more
#      recently than its damper: 1 h the first time, doubling on each repeat
#      while the condition keeps holding, capped at 8 h, and reset once the
#      condition clears (recorded per condition in the state directory);
#   6. when this host serves the live view (MW_MAIL_VIEW_EVERY is set: the
#      install on the host whose postern backend serves the view sets it;
#      unset, there is no view step at all), has a postern key file, and its
#      mw has `mw postern view`
#      (asked once a tick, with `mw postern view --help`, only when a view is
#      otherwise due), and the beads have changed since the last view written
#      or attempted and at least MW_MAIL_VIEW_EVERY seconds (default 30) have
#      passed since then, runs `mw postern view`, bounded to
#      MW_MAIL_VIEW_TIMEOUT seconds (default 60): refreshing the live view the
#      postern backend serves the Governor's app. A run that fails, or that
#      hits the timeout and is killed, is logged once with how long it ran and
#      never stops the tick; either way the next attempt waits a full
#      MW_MAIL_VIEW_EVERY. An mw with no view is passed over silently. The
#      step is retired, and says so once, whenever mw-view-follow.service
#      (`mw postern view --follow`) is active: that service republishes the
#      view within seconds of any bead change, so nothing runs here;
#   7. when this host has a postern key file, and the beads have changed since
#      the last snapshot written or attempted and at least
#      MW_MAIL_SNAPSHOT_EVERY seconds (default 600) have passed since then,
#      runs `mw postern snapshot`, bounded to MW_MAIL_SNAPSHOT_TIMEOUT seconds
#      (default 60) so a slow snapshot can never hold a tick past a minute
#      (mw-tfne4.8): refreshing the brief of every live epic for the
#      Governor's app. A run that fails, or that hits the timeout and is
#      killed, is logged once with how long it ran and never stops the tick;
#      either way the next attempt waits a full MW_MAIL_SNAPSHOT_EVERY, so a
#      snapshot slower than its timeout is never retried every tick
#      (mw-tfne4.12). The view and the snapshot read the beads' level once a
#      tick between them;
#   8. if there is new mail, a postern count risen since last noted, or a
#      clause survived the damper, finds the Mayor's window from the vault's
#      .mayor-acting and, once it is not working and its input line is empty,
#      types "New mail for mayor: <n> message(s). Run bd mail inbox." and
#      Enter, then "New postern message for mayor (<n> unread)" and Enter,
#      then "Quiet alarm for mayor: <clause>[; <clause> ...]. Run mw status."
#      and Enter (checking the window is idle again first before each line
#      after the first, since typing one may have woken it);
#   9. records the mail ids as announced, the postern count as last noted,
#      and each clause's condition as fired, only after each is typed.
#      While a wait is armed (contrib/mail-wait's stamp in the state directory
#      is under MW_MAIL_WAIT_STALE seconds old, 180), the mail line and the
#      postern line are the wait's to tell, whatever sits on the prompt line,
#      and are neither typed nor recorded; the quiet alarm is typed as ever.
#      The mail line is likewise left to mw events follow, and neither typed
#      nor recorded, while mw-view-follow.service is active and the seat's
#      seats/<seat>/subscribe.toml names mail (mw-jrx0s.6).
# Otherwise it does nothing and the next tick tries again.
#
# It never types mail content, never clears an input line, and never starts a
# tmux server, a window or a session. A second tick while one is running does
# nothing (flock). It exits 0 whenever it chose not to act; non-zero is a fault.
# It never syncs, nor asks bd, more than the mail check already did: the
# quiet alarm reads only what that sync left in the vault, under the same lock.
#
# The postern poll (step 4), the live view (step 6) and the postern snapshot
# (step 7) are all skipped silently, with no call to `mw`, on a host with no
# postern key file (config's postern_key_file, default
# ~/.config/mw/postern.key): such a host has no postern side.
#
# The Mayor's window comes from .mayor-acting, which is free text. In it, the
# first of these that names exactly one window on the tmux server wins:
# a window id (@12); a window's name (mayor-2026-09-19-10); "window 3" or
# "window #3", the window's index. A window that cannot be told is left alone.
#
# The quiet alarm's two limits — how long a claimed story may run with nothing
# mailed about it (default 60 minutes), and how stale another host's last
# sync may be (default 20 minutes) — are `mw nudge`'s own settings,
# nudge_after_minutes and nudge_sync_stale_minutes in ~/.config/mw/config.toml
# (see README.md, "What a host is told"), not this script's.
#
# The host may set, in the unit's environment or in mail-notify.env beside it:
#   MW_VAULT             the vault (else the `vault` key of ~/.config/mw/config.toml)
#   MW_MAIL_MAILBOX      whose inbox to watch                          (mayor)
#   MW_MAIL_LOAD_LIMIT   skip the tick above this 1-minute load     (nproc)
#                        (2.0 where the cores cannot be counted)
#   MW_MAIL_SYNC_EVERY   least seconds between two `mw sync`s          (300)
#                        On the host that keeps the one beads database
#                        (beads_sync = "backup") a sync is local writes and
#                        a backup only once one is due, with no remote round
#                        trip, so 60 is sensible there; a host whose beads
#                        are a copy of its own (remote) keeps 300
#   MW_MAIL_STATE_DIR    the ids announced, the quiet alarm's dampers,
#                        the last sync, the last view, the last snapshot,
#                        the lock
#                        (${XDG_STATE_HOME:-~/.local/state}/mw-mail-notify);
#                        a mailbox but the mayor's keeps its own in <dir>/<mailbox>
#   MW_MAIL_LOADAVG_FILE where the load average is read (/proc/loadavg; else uptime)
#   MW_MAIL_VIEW_EVERY   least seconds between two `mw postern view`s; set
#                        only on the host that serves the live view (30
#                        there, as hosts/desktop-move.md installs it);
#                        unset, no view step                         (unset)
#   MW_MAIL_VIEW_TIMEOUT seconds `mw postern view` (step 6) may run before
#                        it is killed                                   (60)
#   MW_MAIL_VIEW_MAX_AGE seconds the last view may age, with the beads
#                        changed, before a tick skipped for load publishes
#                        it anyway (step 1)                            (300)
#   MW_MAIL_SNAPSHOT_EVERY
#                        least seconds between two `mw postern snapshot`s
#                                                                       (600)
#   MW_MAIL_SNAPSHOT_TIMEOUT
#                        seconds `mw postern snapshot` (step 7) may run before
#                        it is killed, so a slow snapshot never holds a tick
#                        past a minute (mw-tfne4.8); raise it on a host where
#                        a snapshot takes longer than this to build (see
#                        README.md, "Telling the Mayor's window when mail
#                        arrives")                                      (60)
#   MW_MAIL_WAIT_STALE   seconds a wait's stamp counts as armed          (180)
#   MW_TMUX_SOCKET       a tmux server other than the default, as `tmux -L`

set -u

MAILBOX=${MW_MAIL_MAILBOX:-mayor}
LOAD_LIMIT=${MW_MAIL_LOAD_LIMIT:-}
SYNC_EVERY=${MW_MAIL_SYNC_EVERY:-300}
STATE=${MW_MAIL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mw-mail-notify}
# Every mailbox but the Mayor's keeps its own state under $STATE/<mailbox>, so the
# Deputy's wait never overwrites what the Mayor's notifier has announced.
[ "$MAILBOX" = mayor ] || STATE=$STATE/$MAILBOX
LOADAVG=${MW_MAIL_LOADAVG_FILE:-/proc/loadavg}
SNAPSHOT_TIMEOUT=${MW_MAIL_SNAPSHOT_TIMEOUT:-60}
SNAPSHOT_EVERY=${MW_MAIL_SNAPSHOT_EVERY:-600}
VIEW_EVERY=${MW_MAIL_VIEW_EVERY:-}
VIEW_TIMEOUT=${MW_MAIL_VIEW_TIMEOUT:-60}
VIEW_MAX_AGE=${MW_MAIL_VIEW_MAX_AGE:-300}
WAIT_STALE=${MW_MAIL_WAIT_STALE:-180}

# A setting that is not a whole number of seconds reads as its default.
case $SYNC_EVERY in '' | *[!0-9]*) SYNC_EVERY=300 ;; esac
case $SNAPSHOT_TIMEOUT in '' | *[!0-9]*) SNAPSHOT_TIMEOUT=60 ;; esac
case $SNAPSHOT_EVERY in '' | *[!0-9]*) SNAPSHOT_EVERY=600 ;; esac
# MW_MAIL_VIEW_EVERY is the exception: unset is its own setting, no view step;
# set but not a number, it reads as 30.
case $VIEW_EVERY in '') ;; *[!0-9]*) VIEW_EVERY=30 ;; esac
case $VIEW_TIMEOUT in '' | *[!0-9]*) VIEW_TIMEOUT=60 ;; esac
case $VIEW_MAX_AGE in '' | *[!0-9]*) VIEW_MAX_AGE=300 ;; esac
case $WAIT_STALE in '' | *[!0-9]*) WAIT_STALE=180 ;; esac

# The load limit unset is this host's core count, so a host is only "busy" when
# it has more running than it has cores (mw-gq6.150); a host whose cores cannot
# be counted keeps 2.0.
if [ -z "$LOAD_LIMIT" ]; then
	LOAD_LIMIT=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo "")
	case $LOAD_LIMIT in '' | *[!0-9]* | 0) LOAD_LIMIT=2.0 ;; esac
fi

# How long a quiet alarm condition, once typed, is left untyped again: 1 h the
# first time, then doubled on each repeat while the condition keeps holding,
# up to this cap.
NUDGE_DAMPER_SECONDS=3600
NUDGE_DAMPER_MAX_SECONDS=28800

say() { echo "mail-notify: $*"; }
die() { echo "mail-notify: $*" >&2; exit 1; }
tmx() { tmux ${MW_TMUX_SOCKET:+-L "$MW_TMUX_SOCKET"} "$@"; }

# The vault: $MW_VAULT, else the root-table `vault` key of mw's config file.
vault=${MW_VAULT:-}
if [ -z "$vault" ] && [ -r "$HOME/.config/mw/config.toml" ]; then
	vault=$(sed -n '/^[[:space:]]*\[/q; s/^[[:space:]]*vault[[:space:]]*=[[:space:]]*//p' "$HOME/.config/mw/config.toml" | head -n 1)
	case $vault in
	\"*) vault=${vault#\"}; vault=${vault%%\"*} ;;
	\'*) vault=${vault#\'}; vault=${vault%%\'*} ;;
	*) vault=${vault%%#*}; vault=${vault%"${vault##*[![:space:]]}"} ;;
	esac
fi
[ -n "$vault" ] || die "no vault: set MW_VAULT, or \`vault = \"...\"\` in ~/.config/mw/config.toml"
[ -d "$vault" ] || die "the vault $vault is not a directory"

# The postern key file: $MW_POSTERN_KEY_FILE, else the root-table
# `postern_key_file` key of mw's config file, else the default under the home
# directory (infrastructure/config's PosternKeyFile). Never fatal when it is
# not there: that host simply has no postern side.
keyfile=${MW_POSTERN_KEY_FILE:-}
if [ -z "$keyfile" ] && [ -r "$HOME/.config/mw/config.toml" ]; then
	keyfile=$(sed -n '/^[[:space:]]*\[/q; s/^[[:space:]]*postern_key_file[[:space:]]*=[[:space:]]*//p' "$HOME/.config/mw/config.toml" | head -n 1)
	case $keyfile in
	\"*) keyfile=${keyfile#\"}; keyfile=${keyfile%%\"*} ;;
	\'*) keyfile=${keyfile#\'}; keyfile=${keyfile%%\'*} ;;
	*) keyfile=${keyfile%%#*}; keyfile=${keyfile%"${keyfile##*[![:space:]]}"} ;;
	esac
fi
[ -n "$keyfile" ] || keyfile="$HOME/.config/mw/postern.key"

command -v flock >/dev/null 2>&1 || die "flock is not installed"
command -v tmux >/dev/null 2>&1 || die "tmux is not installed"
command -v timeout >/dev/null 2>&1 || die "timeout is not installed"
mkdir -p "$STATE" || die "cannot make $STATE"

# Never two at once: a tick that finds another running does nothing.
exec 9>"$STATE/lock"
flock -n 9 || { say "another tick is running; nothing to do"; exit 0; }

# The beads' level: `bd vc status`'s own commit, cheap beside the view or the
# snapshot. Read at most once a tick, and only by a step that is otherwise due;
# a bd too old to have it, or a call that fails, reads as "" — "changed" to
# both steps, so their intervals alone still bound how often each is tried.
level_read=0
level=""
beads_level() {
	[ "$level_read" -eq 1 ] && return 0
	level=$(cd "$vault" && bd vc status --json 2>/dev/null | sed -n 's/.*"commit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
	level_read=1
}

# 6. The live view: on a host that serves it (MW_MAIL_VIEW_EVERY set) with a
# postern key file whose mw has `mw postern view`, refreshed only when the beads
# have changed since the marker left by the last attempt and at least VIEW_EVERY seconds have passed since then —
# the postern backend serves the file to the Governor's app, and a view the
# beads have not moved since is not worth rebuilding. Whether mw has the view
# at all is asked once a tick, only when one is otherwise due: `mw postern
# view --help` prints the view's own usage line when there is one, and
# postern's own help, exit 0 all the same, when there is not — so it is that
# line that is looked for, never the status. An mw without it is passed over
# with nothing recorded, so it is asked again next tick. Bounded to
# VIEW_TIMEOUT seconds, logged once with how long it ran when it fails or is
# killed, and never stops the tick; the time and the level are recorded before
# the attempt runs, so one that hangs or fails is not retried before
# VIEW_EVERY has passed again. Returns 0 when it ran `mw postern view` (which
# may have failed), else 1. Step 1 calls it too, on a tick skipped for load;
# view_stale says whether that tick should.
view_step() {
	view_ran=1
	[ -n "$VIEW_EVERY" ] && [ -r "$keyfile" ] || return 1
	view_followed && return 1
	view_last=$(cat "$STATE/view-last" 2>/dev/null || echo 0)
	case $view_last in *[!0-9]* | "") view_last=0 ;; esac
	if [ $((now - view_last)) -ge "$VIEW_EVERY" ]; then
		beads_level
		view_noted=$(cat "$STATE/view-level" 2>/dev/null || echo "")
		if [ -z "$level" ] || [ "$level" != "$view_noted" ]; then
			if (cd "$vault" && mw postern view --help 2>/dev/null) | grep -q 'mw postern view'; then
				echo "$now" >"$STATE/view-last"
				[ -n "$level" ] && echo "$level" >"$STATE/view-level"
				view_ran=0
				start=$now
				(cd "$vault" && timeout "$VIEW_TIMEOUT" mw postern view >/dev/null 2>&1)
				status=$?
				if [ "$status" -ne 0 ]; then
					elapsed=$(($(date +%s) - start))
					[ "$elapsed" -lt 0 ] && elapsed=0
					if [ "$status" -eq 124 ]; then
						say "mw postern view exceeded ${VIEW_TIMEOUT}s and was killed after ${elapsed}s; not retrying before ${VIEW_EVERY}s have passed"
					else
						say "mw postern view did not finish cleanly after ${elapsed}s; not retrying before ${VIEW_EVERY}s have passed"
					fi
				fi
			fi
		fi
	fi
	return "$view_ran"
}

# view_followed succeeds when mw-view-follow.service (`mw postern view
# --follow`, which republishes the view within seconds of any bead change) is
# active on this host: this step is then retired and runs nothing. It says so
# once each time it finds the service active, and forgets it when it is not.
view_followed() {
	if systemctl --user is-active --quiet mw-view-follow.service >/dev/null 2>&1; then
		if [ ! -f "$STATE/view-retired" ]; then
			say "the view step is retired, mw postern view --follow does it (mw-view-follow.service is active)"
			: >"$STATE/view-retired"
		fi
		return 0
	fi
	rm -f "$STATE/view-retired"
	return 1
}

# view_stale prints how many seconds old the last view is, and succeeds, only
# when this host serves the view and that age is at least VIEW_MAX_AGE.
view_stale() {
	[ -n "$VIEW_EVERY" ] && [ -r "$keyfile" ] || return 1
	view_followed && return 1
	stale_last=$(cat "$STATE/view-last" 2>/dev/null || echo 0)
	case $stale_last in *[!0-9]* | "") stale_last=0 ;; esac
	stale=$((now - stale_last))
	[ "$stale" -ge "$VIEW_MAX_AGE" ] || return 1
	echo "$stale"
}

# 1. Load. A busy host is not asked to sync or to read beads. It is still asked
# to publish the live view (step 6, run by view_step above) when the beads have
# changed and the last view is over VIEW_MAX_AGE seconds old: a host that
# stays busy for hours would otherwise leave the Governor's app on a view that
# old (mw-gq6.150). The mail, the postern poll, the quiet alarm and the
# snapshot stay skipped.
now=$(date +%s)
if [ -r "$LOADAVG" ]; then
	load=$(cut -d ' ' -f 1 "$LOADAVG")
else
	load=$(uptime | sed 's/.*load averages*: *//; s/[ ,].*//')
fi
if awk -v l="${load:-0}" -v m="$LOAD_LIMIT" 'BEGIN { exit !(l + 0 > m + 0) }'; then
	if view_stale_seconds=$(view_stale) && view_step; then
		say "load $load is above $LOAD_LIMIT; skipping this tick but publishing the view, ${view_stale_seconds}s stale"
	else
		say "load $load is above $LOAD_LIMIT; skipping this tick"
	fi
	exit 0
fi

# 2. Sync, at low priority, and no oftener than every SYNC_EVERY seconds. The
# time is written before the run so a sync that fails or hangs is not retried
# at every tick.
last=$(cat "$STATE/last-sync" 2>/dev/null || echo 0)
case $last in *[!0-9]* | "") last=0 ;; esac
if [ $((now - last)) -ge "$SYNC_EVERY" ]; then
	echo "$now" >"$STATE/last-sync"
	slow=""
	command -v ionice >/dev/null 2>&1 && slow="ionice -c 3"
	# shellcheck disable=SC2086
	(cd "$vault" && nice -n 19 $slow mw sync >/dev/null 2>&1) || say "mw sync did not finish cleanly; carrying on with what the vault holds"
fi

# 3. The inbox. Only lines that start with a bead id count: an empty inbox
# prints a sentence, not an id. A bd that fails leaves this part with nothing,
# rather than stopping the tick: the quiet alarm below still gets its turn.
new=""
count=0
if listing=$(cd "$vault" && bd mail inbox "$MAILBOX" 2>/dev/null); then
	current=$(echo "$listing" | awk 'NF { print $1 }' | grep -E '^[[:alnum:]]+(-[[:alnum:].]+)+$' | sort -u)
	if [ -n "$current" ]; then
		new=$(echo "$current" | grep -vxFf "$STATE/announced" 2>/dev/null || true)
		if [ ! -f "$STATE/announced" ]; then new=$current; fi
	fi
fi
[ -n "$new" ] && count=$(echo "$new" | wc -l | tr -d ' ')

# 4. The postern inbox: skipped silently, with no call to mw, on a host with
# no postern key file. A count above zero and higher than what was last
# noted is something to type; the same count again, or a lower one, is not,
# but a lower one is noted at once as the count last noted.
postern_text=""
postern_count=0
if [ -r "$keyfile" ]; then
	postern_count=$(cd "$vault" && mw postern inbox --unread-count 2>/dev/null) || postern_count=""
	postern_polled=1
	case $postern_count in *[!0-9]* | "") postern_count=0 postern_polled=0 ;; esac
	postern_last=$(cat "$STATE/postern-count" 2>/dev/null || echo 0)
	case $postern_last in *[!0-9]* | "") postern_last=0 ;; esac
	# A fall in the count (the Mayor read the inbox) is noted at once, so the
	# next message counts as a rise and is announced (mw-gq6.133); a poll that
	# failed says nothing about the count and is not a fall.
	if [ "$postern_polled" -eq 1 ] && [ "$postern_count" -lt "$postern_last" ]; then
		mkdir -p "$STATE" && echo "$postern_count" >"$STATE/postern-count"
		postern_last=$postern_count
	fi
	if [ "$postern_count" -gt 0 ] && [ "$postern_count" -gt "$postern_last" ]; then
		postern_text="New postern message for $MAILBOX ($postern_count unread)"
	fi
fi

# 5. The quiet alarm: what `mw nudge` says is true right now, reusing the beads
# the sync above already left in the vault. A condition that keeps holding is
# typed less and less often (see NUDGE_DAMPER_SECONDS above), so a sleeping
# host is not re-announced every tick all night.
tab=$(printf '\t')
nudge_texts=""
nudge_fired=""
nudge_keys=""
if nudge_raw=$(cd "$vault" && mw nudge 2>/dev/null) && [ -n "$nudge_raw" ]; then
	while IFS="$tab" read -r key text; do
		[ -n "$key" ] || continue
		safe=$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')
		nudge_keys="$nudge_keys$safe
"
		fired=0
		wait=0
		if [ -f "$STATE/nudged/$safe" ]; then
			read -r fired wait <"$STATE/nudged/$safe"
			case $fired in '' | *[!0-9]*) fired=0 ;; esac
			case $wait in '' | *[!0-9]*) wait=0 ;; esac
		fi
		if [ $((now - fired)) -lt "$wait" ]; then
			continue
		fi
		if [ -n "$nudge_texts" ]; then nudge_texts="$nudge_texts; $text"; else nudge_texts=$text; fi
		if [ "$wait" -eq 0 ]; then
			next=$NUDGE_DAMPER_SECONDS
		else
			next=$((wait * 2))
			[ "$next" -gt "$NUDGE_DAMPER_MAX_SECONDS" ] && next=$NUDGE_DAMPER_MAX_SECONDS
		fi
		nudge_fired="$nudge_fired$safe $next
"
	done <<-EOF
	$nudge_raw
	EOF
fi

# A condition `mw nudge` no longer names has cleared: drop its damper, so its
# next return is typed at once instead of held to whatever wait it had
# reached before.
if [ -d "$STATE/nudged" ]; then
	for file in "$STATE/nudged"/*; do
		[ -e "$file" ] || continue
		base=$(basename "$file")
		echo "$nudge_keys" | grep -qxF "$base" || rm -f "$file"
	done
fi

# 6. The live view, above; its result is not needed here.
view_step

# 7. The postern snapshot: on a host with a postern key file, refreshed only
# when the beads have changed since the marker left by the last attempt and
# at least SNAPSHOT_EVERY seconds have passed since then — the app reads it
# independently of the tmux window, and a snapshot this host's beads have not
# moved since is not worth rebuilding (mw-tfne4.12). The marker is the beads'
# level, read above, shared with the view. Bounded to SNAPSHOT_TIMEOUT seconds: a
# snapshot that runs long is killed rather than starving every tick after it
# (mw-tfne4.8), logged once with how long it ran either way, and never stops
# the tick: the app simply serves the last good snapshot until the next one
# gets through. The time and the level are both recorded before the attempt
# runs, so one that hangs or fails is not retried before SNAPSHOT_EVERY has
# passed again.
if [ -r "$keyfile" ]; then
	snap_last=$(cat "$STATE/snapshot-last" 2>/dev/null || echo 0)
	case $snap_last in *[!0-9]* | "") snap_last=0 ;; esac
	if [ $((now - snap_last)) -ge "$SNAPSHOT_EVERY" ]; then
		beads_level
		noted=$(cat "$STATE/snapshot-level" 2>/dev/null || echo "")
		if [ -z "$level" ] || [ "$level" != "$noted" ]; then
			echo "$now" >"$STATE/snapshot-last"
			[ -n "$level" ] && echo "$level" >"$STATE/snapshot-level"
			start=$now
			(cd "$vault" && timeout "$SNAPSHOT_TIMEOUT" mw postern snapshot >/dev/null 2>&1)
			status=$?
			if [ "$status" -ne 0 ]; then
				elapsed=$(($(date +%s) - start))
				[ "$elapsed" -lt 0 ] && elapsed=0
				if [ "$status" -eq 124 ]; then
					say "mw postern snapshot exceeded ${SNAPSHOT_TIMEOUT}s and was killed after ${elapsed}s; not retrying before ${SNAPSHOT_EVERY}s have passed"
				else
					say "mw postern snapshot did not finish cleanly after ${elapsed}s; not retrying before ${SNAPSHOT_EVERY}s have passed"
				fi
			fi
		fi
	fi
fi

# A wait armed by the Mayor's harness (contrib/mail-wait, which stamps
# $STATE/wait-armed each poll) tells the Mayor of mail and of a postern message
# itself, whatever sits on its prompt line: while its stamp is under
# MW_MAIL_WAIT_STALE seconds old (180), neither is typed here, nor recorded, so
# the wait finds them still new. With no wait armed this types them as before.
# The quiet alarm is not the wait's and is typed either way.
wait_armed=0
if [ -r "$STATE/wait-armed" ]; then
	read -r beat <"$STATE/wait-armed" || beat=""
	case $beat in '' | *[!0-9]*) beat=0 ;; esac
	[ $((now - beat)) -lt "$WAIT_STALE" ] && wait_armed=1
fi
if [ "$wait_armed" -eq 1 ] && { [ -n "$new" ] || [ -n "$postern_text" ]; }; then
	say "a wait is armed; leaving the mail and the postern message to it"
	new=""
	postern_text=""
fi

# mw events follow (mw-view-follow.service) tells a seat of its mail itself,
# typing the nudge into an idle pane or springing the seat, when the seat's
# seats/<seat>/subscribe.toml names mail among its kinds: while it is active the
# mail line is its to type, and is neither typed nor recorded here. The postern
# line and the quiet alarm are not the follower's, and are typed as ever.
if [ -n "$new" ] && grep -Eq '^[[:space:]]*kinds[[:space:]]*=.*mail' "$vault/seats/$MAILBOX/subscribe.toml" 2>/dev/null &&
	systemctl --user is-active --quiet mw-view-follow.service >/dev/null 2>&1; then
	if [ ! -f "$STATE/mail-deferred" ]; then
		say "the mail line is retired, mw events follow tells $MAILBOX of its mail (mw-view-follow.service is active)"
		: >"$STATE/mail-deferred"
	fi
	new=""
else
	rm -f "$STATE/mail-deferred"
fi

[ -n "$new" ] || [ -n "$postern_text" ] || [ -n "$nudge_texts" ] || exit 0

# 8. The Mayor's window, from the vault's .mayor-acting.
acting=$(cat "$vault/.mayor-acting" 2>/dev/null) || acting=""
[ -n "$acting" ] || { say "something to tell $MAILBOX, but $vault/.mayor-acting names no one; will try again"; exit 0; }
windows=$(tmx list-windows -a -F "#{window_id}${tab}#{window_index}${tab}#{window_name}" 2>/dev/null) ||
	{ say "something to tell $MAILBOX, but there is no tmux server to tell; will try again"; exit 0; }

target=""
for id in $(echo "$acting" | grep -o '@[0-9][0-9]*'); do
	if echo "$windows" | cut -f 1 | grep -qx "$id"; then target=$id; break; fi
done
if [ -z "$target" ]; then
	# A name of the shape the Mayor's windows have, found whole in the text.
	found=$(echo "$windows" | while IFS="$tab" read -r id _ name; do
		case $name in mayor*) case $acting in *"$name"*) echo "$id" ;; esac ;; esac
	done)
	[ "$(echo "$found" | grep -c .)" -eq 1 ] && target=$found
fi
if [ -z "$target" ]; then
	index=$(echo "$acting" | sed -n 's/.*[Ww]indow[: #]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
	if [ -n "$index" ]; then
		found=$(echo "$windows" | awk -F "$tab" -v i="$index" '$2 == i { print $1 }')
		[ "$(echo "$found" | grep -c .)" -eq 1 ] && target=$found
	fi
fi
[ -n "$target" ] || { say "something to tell $MAILBOX, but .mayor-acting ($acting) names no one window; will try again"; exit 0; }

# Idle, with an empty input line: the test of the vault's bin/mayor-reap-window.
# Claude Code's empty input line is the prompt mark and a no-break space (c2 a0):
# make it a plain space before matching. capture-pane -e reads the screen with
# its escapes: Claude Code's suggested next prompt is drawn after the mark as dim
# text (SGR 2), which is not a draft, so only undimmed text after the mark makes
# the line not empty. The same rule as infrastructure/tmux's inputLineHoldsDraft.
nbsp=$(printf '\302\240')
esc=$(printf '\033')
# input_line_state reads a screen on stdin and says "empty" when a prompt line
# holds nothing but blank space and dim text, "draft" when undimmed text follows
# the mark on every prompt line, and "none" when no line starts with the mark.
# awk is put on bytes, the mark being three of them.
input_line_state() {
	LC_ALL=C awk -v esc="$esc" '
	function holds_draft(line,   dim, seen, params, n, i, a, c) {
		dim = 0; seen = 0
		while (line != "") {
			if (substr(line, 1, 1) == esc) {
				if (match(line, "^" esc "\\[[0-9;:]*[@-~]")) {
					if (substr(line, RLENGTH, 1) == "m") {
						params = substr(line, 3, RLENGTH - 3)
						n = split(params, a, /[;:]/)
						if (n == 0) dim = 0
						for (i = 1; i <= n; i++) {
							if (a[i] ~ /^0*$/ || a[i] == "22") dim = 0
							else if (a[i] == "2" || a[i] == "02") dim = 1
							else if (a[i] == "38" || a[i] == "48" || a[i] == "58") {
								if (a[i + 1] == "5") i += 2
								else if (a[i + 1] == "2") i += 4
							}
						}
					}
					line = substr(line, RLENGTH + 1)
				} else line = substr(line, 2)
				continue
			}
			c = substr(line, 1, 1)
			line = substr(line, 2)
			if (!seen) {
				if (c != "\342") return -1
				if (substr(line, 1, 2) != "\235\257") return -1
				line = substr(line, 3); seen = 1
			} else if (c != " " && !dim) return 1
		}
		return seen ? 0 : -1
	}
	{ r = holds_draft($0); if (r == 1) draft = 1; else if (r == 0) empty = 1 }
	END { print empty ? "empty" : (draft ? "draft" : "none") }'
}
pane_idle() {
	pane=$(tmx capture-pane -p -e -t "$target" 2>/dev/null | sed "s/$nbsp/ /g") || return 2
	if echo "$pane" | sed "s/$esc\\[[0-9;:]*[@-~]//g" | grep -q 'esc to interrupt'; then return 1; fi
	[ "$(echo "$pane" | input_line_state)" = empty ] || return 1
	return 0
}
type_line() {
	# type_line LINE: types LINE and Enter into $target. A pause before Enter,
	# so that a TUI reads the text first.
	tmx send-keys -t "$target" -l "$1" || return 1
	sleep 0.5
	tmx send-keys -t "$target" Enter
}

pane_idle
status=$?
if [ "$status" -eq 2 ]; then
	say "cannot read window $target; will try again"
	exit 0
elif [ "$status" -ne 0 ]; then
	say "something to tell $MAILBOX, but the Mayor's window $target is working, or its input line is not empty; will try again"
	exit 0
fi

typed_mail=0
if [ -n "$new" ]; then
	line="New mail for $MAILBOX: $count message(s). Run bd mail inbox."
	if type_line "$line"; then
		# 9. Only now are the ids announced. What is no longer in the inbox is
		# dropped from the record, so it does not grow.
		echo "$current" >"$STATE/announced"
		say "typed into $target: $line"
		typed_mail=1
	else
		say "typing into $target failed; will try again"
	fi
fi

typed_postern=0
if [ -n "$postern_text" ]; then
	ready=0
	if [ "$typed_mail" -eq 1 ]; then
		pane_idle && ready=1
	else
		ready=1
	fi
	if [ "$ready" -eq 1 ]; then
		if type_line "$postern_text"; then
			# 9. Only now is the count last noted, the same as the mail ids above.
			echo "$postern_count" >"$STATE/postern-count"
			say "typed into $target: $postern_text"
			typed_postern=1
		else
			say "typing into $target failed; will try again"
		fi
	else
		say "something to tell $MAILBOX, but window $target is busy again after the mail line; will try again"
	fi
fi

if [ -n "$nudge_texts" ]; then
	ready=0
	if [ "$typed_mail" -eq 1 ] || [ "$typed_postern" -eq 1 ]; then
		pane_idle && ready=1
	else
		ready=1
	fi
	if [ "$ready" -eq 1 ]; then
		line="Quiet alarm for $MAILBOX: $nudge_texts. Run mw status."
		if type_line "$line"; then
			mkdir -p "$STATE/nudged"
			printf '%s' "$nudge_fired" | while IFS=" " read -r safe wait; do
				[ -n "$safe" ] && echo "$now $wait" >"$STATE/nudged/$safe"
			done
			say "typed into $target: $line"
		else
			say "typing into $target failed; will try again"
		fi
	else
		say "the quiet alarm has something to say, but window $target is busy again after the mail line; will try again"
	fi
fi
