#!/bin/bash
# Make and unmake one Boost on Vultr: a High Performance 8 vCPU / 16 GB box that
# boots through cloud-init into contrib/boost-bootstrap.sh, and joins the
# factory's WireGuard network as a peer of the hub. Run on the home, which holds
# the age key that opens the vault's secrets.
#
#   contrib/vultr-boost up       [--yes] [--dry-run] [--name NAME] [--snapshot ID]
#   contrib/vultr-boost down     [--yes] [--dry-run] [--name NAME] [--instance ID]
#   contrib/vultr-boost list
#   contrib/vultr-boost adopt    [--yes] [--dry-run] --name NAME --instance ID
#   contrib/vultr-boost status   [--name NAME]
#   contrib/vultr-boost snapshot [--dry-run] [--name NAME]
#   contrib/vultr-boost spend    [--name NAME]...
#   contrib/vultr-boost set-cap  [--dry-run] --name NAME --cap N
#   contrib/vultr-boost set-pace [--dry-run] --name NAME
#   contrib/vultr-boost check    [--dry-run] --name NAME
#   contrib/vultr-boost set-harness [--dry-run] --name NAME --version VERSION
#   contrib/vultr-boost set-session-deny [--dry-run] --name NAME --deny '["rule", ...]'
#   contrib/vultr-boost address  [--dry-run] --name NAME
#   contrib/vultr-boost --help
#
# up      keys the box (hosts/vultr/wg.key.age, once), enrols its public key on the
#         hub over ssh (the hub's wg0.conf is backed up first, and the way back is
#         printed), then terraform apply makes the box. Terraform asks you to
#         confirm unless --yes is given. A second up changes nothing it need not.
# down    terraform destroy removes the box, then the peer comes off the hub (again
#         backed up first). The keys stay in the vault for the next up.
#         --instance ID also deletes that Vultr instance by its id, for an orphan no
#         state holds (a make that was killed): terraform destroy finds nothing then.
#         With no state and no --instance, a box Vultr still holds keeps its peer on
#         the hub (down says so and exits well; --instance ID then deletes it).
# list    every instance Vultr holds on the account, one line each: id, label, status
#         and server status separated by tabs. mw's cloud check reads it to find
#         orphans, and to read back what Vultr says of a box before the book does.
# adopt   terraform import of a Vultr instance into the box's state, for a box whose
#         make ran past its deadline while Vultr was still restoring it (a snapshot
#         restore takes ~50 minutes): once adopted, down finds it. The firewall group
#         the killed apply made is left on Vultr (it costs nothing).
# status  the box's state (from the state in the vault and Vultr's API) and what it
#         costs; with no box, the price one would cost.
# snapshot  makes a Vultr snapshot of a box that is up and bootstrapped, and prints its
#         id: the ready-made image `up --snapshot ID` (mw's [cloud] snapshot) makes a box
#         from, working in a couple of minutes instead of bootstrapping in full. It asks the
#         box first, over ssh, and snapshots none whose bootstrap (cloud-init) has not finished or
#         ended in error (mw-gq6.1277).
# spend   what Vultr's pending charges say the boxes named have cost this month, in
#         dollars, or "unknown" when the billing could not be read: mw's cloud check
#         takes it when it is more than its own count.
# set-cap sets `cap = N` in the config of a box that is up, over WireGuard: the box's address is
#         read off the hub (nothing there changes), then ssh to the box's user runs a small
#         rewrite of the first `cap` line of ~/.config/mw/config.toml (its own, atomic: the
#         other lines stay as they were). The box's next dispatch reads it: no restart, and
#         sessions running are not touched. mw's cloud check runs it when [cloud] box_cap
#         changes (mw cloud cap N).
# set-pace makes the dispatch timer of a box that is up tick every five minutes, over WireGuard as
#         set-cap does: ssh to the box's user writes the timer drop-in boost-pace.conf
#         (OnCalendar= then OnCalendar=*:0/5, as boost-bootstrap.sh writes it) when it is not as
#         that, reloads systemd, restarts the timer and starts one dispatch now, then prints the
#         OnCalendar the timer has, on a "pace = " line. A box made from the snapshot carries the
#         home's hourly timer, and a box has no event follower to spring its dispatch. mw's cloud
#         check runs it on each box it does not know to be at the pace (mw-gq6.1004).
# check   has a box that is up check its own disk, over WireGuard as set-pace does: ssh to the box's
#         user runs git fsck --connectivity-only on every checkout under its home (the vault and each
#         rig), go mod verify in ~/millwright, counts the EXT4-fs error lines of the kernel log, and
#         looks for files older than the box's boot that begin with a block of zeros (a snapshot
#         restore that did not write the whole disk).
#         Each thing wrong is a "fault = " line, and the last line, "check = ...", says the check ran
#         to its end; it exits 0 whatever it found on the disk, and not 0 when the box could not be
#         asked or its bootstrap (cloud-init) ended in error: that is one "fault = " line, no
#         "check = " line and the disk not read, because such a box is not whole whatever its disk
#         reads (mw-gq6.1189). It changes nothing on the box. mw's cloud check runs it before a box
#         may take a story and every hour after: cloud4 and cloud5 came up from the snapshot with
#         corrupt git packs, a corrupt Go module cache and EXT4-fs errors, and took stories
#         (mw-gq6.1172).
# set-harness brings the Claude Code of a box that is up to VERSION (the home's, which mw version
#         prints), over WireGuard as set-pace does: ssh to the box's user reads `claude --version`,
#         and a box behind VERSION gets one npm install -g --prefix ~/.local
#         @anthropic-ai/claude-code@VERSION; a box level with it or ahead of it is left alone. It prints
#         one last line, "harness = A -> B", "harness = A level" or "harness = A stays: WHY", and a
#         failed install is a "stays" line with exit 0, never a box that cannot start a session. A box
#         made from the snapshot comes up at the snapshot's version; mw's cloud check runs it before it
#         sets the box's dispatch timer (mw-gq6.1059).
# set-session-deny makes the [session] table of a box's config.toml hold `deny = DENY` (the home's
#         list of permission rules every story session is refused, a one-line TOML array of strings),
#         over WireGuard as set-cap does: the box's `deny` line is replaced (a multi-line one too), or
#         added to its [session] table, or a [session] table is added at the end of the file; every
#         other line stays as it was, and a file that would not change is not written. It prints one
#         last line, "session.deny = set" or "session.deny = level". The box's next dispatch reads
#         it; sessions running are not touched. mw's cloud check runs it on each box whose kept list
#         is not the home's (mw-t5shinh.33).
# address prints a box's WireGuard address, read off the hub as set-cap reads it (nothing there
#         changes), then the user the box dispatches as: two lines, the address and the user. mw
#         peek, retry and pause reach a box at ssh <user>@<address>: the home resolves no name for it.
# --name  the box: its host name, peer name and its own state and key in the vault
#         (default: the tfvars name, else cloud1). mw names its boxes cloud1, cloud2.
# --dry-run prints every step and what it would run, and changes nothing.
#
# Where things live. The terraform code is contrib/terraform/vultr-boost. The
# settings (region, the hub's endpoint, the beads host, ...) are the tfvars file
# hosts/vultr/vultr-boost.tfvars in the private vault; docs/vultr-boost.md lists
# them. Beside it the vault keeps the box's WireGuard key (wg.key.age, wg.pub) and
# terraform's state (terraform.tfstate.age), both encrypted with age to the
# recipient of the home's key and committed. The tokens are in `mw secrets`:
#   vultr_api_token (required)   boost_github_token, boost_claude_token,
#   boost_beads_password (each optional: the box lacks what is not kept)
#
# No secret is put in a command line, a file in the clear or this script's output:
# tokens go to terraform in its environment (TF_VAR_*), to curl as a config on its
# stdin. Terraform's state lives only in a private directory on a tmpfs (memory)
# for the length of one run, and is encrypted back into the vault before it goes.
#
# Settings, all overridable:
#   MW_VAULT             the vault (else the `vault` key of ~/.config/mw/config.toml)
#   MW_AGE_KEY_FILE      the age key (~/.config/mw/age.key)
#   VULTR_BOOST_RUN      a tmpfs directory for the run's private files ($XDG_RUNTIME_DIR, else /dev/shm)
#   VULTR_BOOST_HUB_SSH  where to ssh to change the hub (root@ the host of wg_endpoint)
#   VULTR_BOOST_HUB_ENROL  the hub's wg-enrol command (wg-enrol)

set -eu
set -o pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
TFDIR=${VULTR_BOOST_TFDIR:-$HERE/terraform/vultr-boost}
API=https://api.vultr.com/v2
DRY=0
YES=0
CMD=""
NAME_ARG=""
NAMES=()
INSTANCE=""
SNAPSHOT=""
CAP=""
VERSION=""
DENY=""
STEPS=0
N=0

die() {
	echo "vultr-boost: $*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage: vultr-boost up       [--yes] [--dry-run] [--name NAME] [--snapshot ID]
       vultr-boost down     [--yes] [--dry-run] [--name NAME] [--instance ID]
       vultr-boost list
       vultr-boost adopt    [--yes] [--dry-run] --name NAME --instance ID
       vultr-boost status   [--name NAME]
       vultr-boost snapshot [--dry-run] [--name NAME]
       vultr-boost spend    [--name NAME]...
       vultr-boost set-cap  [--dry-run] --name NAME --cap N
       vultr-boost check    [--dry-run] --name NAME
       vultr-boost set-pace [--dry-run] --name NAME
       vultr-boost set-harness [--dry-run] --name NAME --version VERSION
       vultr-boost set-session-deny [--dry-run] --name NAME --deny '["rule", ...]'
       vultr-boost address  [--dry-run] --name NAME

up makes the Boost box on Vultr and enrols it on the WireGuard hub; down destroys
it and removes the peer; set-cap sets how many sessions a box that is up runs at
once, in its own config, over WireGuard; set-pace has a box's dispatch timer tick every
five minutes; set-harness brings a box's Claude Code up to the home's VERSION; set-session-deny sets the [session] deny list of a box's config; address prints a box's WireGuard address and user
read off the hub; status prints its state and cost; snapshot makes a
ready-made image of a bootstrapped box for up --snapshot; list prints every
instance Vultr holds (id, label, status, server status); adopt imports a Vultr
instance into a box's state; spend prints what the boxes named have
cost this month; down --instance ID also deletes that Vultr instance, for an
orphan no state holds. --name picks the box (default the tfvars name,
else cloud1). --yes passes -auto-approve to terraform (otherwise terraform asks);
--dry-run prints every step and runs none. Settings live in the vault's
hosts/vultr/vultr-boost.tfvars and tokens in `mw secrets`; see docs/vultr-boost.md.
EOF
}

while [ $# -gt 0 ]; do
	case $1 in
	up | down | list | adopt | status | snapshot | spend | set-cap | set-pace | set-harness | set-session-deny | address | check)
		[ -z "$CMD" ] || die "one command at a time: $CMD and $1"
		CMD=$1
		;;
	--name)
		[ $# -gt 1 ] || die "--name needs a box name"
		NAME_ARG=$2
		NAMES+=("$2")
		shift
		;;
	--cap)
		[ $# -gt 1 ] || die "--cap needs a number of sessions"
		CAP=$2
		shift
		;;
	--version)
		[ $# -gt 1 ] || die "--version needs a Claude Code version"
		VERSION=$2
		shift
		;;
	--deny)
		[ $# -gt 1 ] || die "--deny needs the rules as a one-line TOML array of strings"
		DENY=$2
		shift
		;;
	--instance)
		[ $# -gt 1 ] || die "--instance needs a Vultr instance id"
		INSTANCE=$2
		shift
		;;
	--snapshot)
		[ $# -gt 1 ] || die "--snapshot needs a snapshot id"
		SNAPSHOT=$2
		shift
		;;
	--yes | -y) YES=1 ;;
	--dry-run) DRY=1 ;;
	--help | -h)
		usage
		exit 0
		;;
	*)
		echo "vultr-boost: unknown argument: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done
[ -n "$CMD" ] || {
	usage >&2
	exit 2
}

# A key of the root table of mw's config file, as mail-notify and mw-health read it.
config_key() {
	[ -r "$HOME/.config/mw/config.toml" ] || return 0
	local v
	v=$(sed -n "/^[[:space:]]*\\[/q; s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$HOME/.config/mw/config.toml" | head -n 1)
	case $v in
	\"*) v=${v#\"} v=${v%%\"*} ;;
	\'*) v=${v#\'} v=${v%%\'*} ;;
	*) v=${v%%#*} v=${v%"${v##*[![:space:]]}"} ;;
	esac
	echo "$v"
}

VAULT=${MW_VAULT:-$(config_key vault)}
if [ -z "$VAULT" ] || [ ! -d "$VAULT" ]; then
	die "no vault: set MW_VAULT, or \`vault = \"...\"\` in ~/.config/mw/config.toml"
fi
HOSTDIR=$VAULT/hosts/vultr
TFVARS=$HOSTDIR/vultr-boost.tfvars
AGE_KEY=${MW_AGE_KEY_FILE:-$(config_key age_key_file)}
AGE_KEY=${AGE_KEY:-$HOME/.config/mw/age.key}
RUNBASE=${VULTR_BOOST_RUN:-${XDG_RUNTIME_DIR:-/dev/shm}}
ENROL=${VULTR_BOOST_HUB_ENROL:-wg-enrol}

# tfvar NAME: the string value of NAME = "value" in the tfvars file (empty if absent).
tfvar() {
	[ -r "$TFVARS" ] || return 0
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$TFVARS" | head -n 1
}

DEFAULT_NAME=$(tfvar name)
DEFAULT_NAME=${DEFAULT_NAME:-cloud1}
NAME=${NAME_ARG:-$DEFAULT_NAME}
case $NAME in
*[!a-z0-9-]* | "") die "the box name \"$NAME\" must match [a-z0-9-]+ (what wg-enrol accepts)" ;;
esac
# The tfvars name keeps the files it always had; every other box has its own,
# named for it, so two boxes never share a state or a key.
if [ "$NAME" = "$DEFAULT_NAME" ]; then
	STATE_AGE=$HOSTDIR/terraform.tfstate.age
	KEY_AGE=$HOSTDIR/wg.key.age
	PUB_FILE=$HOSTDIR/wg.pub
else
	STATE_AGE=$HOSTDIR/$NAME.tfstate.age
	KEY_AGE=$HOSTDIR/$NAME.wg.key.age
	PUB_FILE=$HOSTDIR/$NAME.wg.pub
fi
case $CAP in
*[!0-9]*) die "the cap \"$CAP\" must be a whole number of sessions" ;;
esac
case $INSTANCE in
*[!a-zA-Z0-9-]*) die "the instance id \"$INSTANCE\" must match [a-zA-Z0-9-]+ (what Vultr issues)" ;;
esac
ENDPOINT=$(tfvar wg_endpoint)
HUB_SSH=${VULTR_BOOST_HUB_SSH:-root@${ENDPOINT%:*}}
[ "$HUB_SSH" != "root@" ] || HUB_SSH="root@<the host of wg_endpoint>"

step() {
	N=$((N + 1))
	echo "==> [$N/$STEPS] $1"
}

would() { echo "    would: $*"; }

need() { # tool...: each on PATH, or die naming the first that is not
	local t
	for t in "$@"; do
		command -v "$t" >/dev/null 2>&1 || die "$t is not installed (needed to $CMD)"
	done
}

hubssh() { # remote command string
	ssh -o BatchMode=yes -o ConnectTimeout=15 "$HUB_SSH" "$1"
}

# --- the dry run: every step, none run ----------------------------------------
plan_up() {
	STEPS=6
	echo "vultr-boost up --dry-run: nothing below is run"
	step "read: settings $TFVARS, tokens vultr_api_token (and boost_github_token, boost_claude_token, boost_beads_password when kept) with mw secrets get"
	would "refuse if vultr_api_token, region, wg_endpoint or beads_host is missing"
	step "state: open $STATE_AGE with age into a private directory under $RUNBASE (a tmpfs); removed on exit"
	step "wireguard: a key for the box, once: wg genkey, kept encrypted in $KEY_AGE, public half in $PUB_FILE"
	step "ssh $HUB_SSH: copy /etc/wireguard/wg0.conf to a dated backup, then $ENROL $NAME <the box's public key>"
	would "print the backup's path and the way back (ssh $HUB_SSH '$ENROL --remove $NAME')"
	step "terraform -chdir=$TFDIR init, then apply -state=<private dir>/terraform.tfstate -var-file=$TFVARS -var name=$NAME$(snapshot_var) (tokens in TF_VAR_* only)"
	would "ask to confirm, or pass -auto-approve with --yes; this is where the box starts to cost money"
	step "state: encrypt it back to $STATE_AGE with age, commit hosts/vultr in the vault, remove the private directory"
}

plan_down() {
	STEPS=5
	echo "vultr-boost down --dry-run: nothing below is run"
	step "read: settings $TFVARS, token vultr_api_token with mw secrets get"
	step "state: open $STATE_AGE with age into a private directory under $RUNBASE (a tmpfs); removed on exit"
	step "terraform -chdir=$TFDIR destroy -state=<private dir>/terraform.tfstate -var-file=$TFVARS (-auto-approve with --yes)"
	[ -n "$INSTANCE" ] || would "with no state in the vault: curl $API/instances with the token on stdin; if Vultr holds an instance labelled $NAME, its peer is left on the hub"
	[ -z "$INSTANCE" ] || would "curl -X DELETE $API/instances/$INSTANCE with the token on stdin: the orphan no state holds"
	step "ssh $HUB_SSH: copy /etc/wireguard/wg0.conf to a dated backup, then $ENROL --remove $NAME"
	would "ssh-keygen -R <the peer's address, read off the hub> -f ~/.ssh/known_hosts: a box remade on it has a new host key"
	step "state: encrypt it back to $STATE_AGE with age, commit hosts/vultr in the vault, remove the private directory"
}

# box_user: the user the box dispatches as, the tfvars user (default mw).
box_user() {
	local u
	u=$(tfvar user)
	echo "${u:-mw}"
}

snapshot_var() {
	[ -z "$SNAPSHOT" ] || echo " -var snapshot_id=$SNAPSHOT"
}

if [ "$DRY" = 1 ]; then
	case $CMD in
	up) plan_up ;;
	down) plan_down ;;
	adopt)
		STEPS=3
		echo "vultr-boost adopt --dry-run: nothing below is run"
		step "state: open $STATE_AGE with age into a private directory under $RUNBASE (a tmpfs); removed on exit"
		step "terraform -chdir=$TFDIR import -state=<private dir>/terraform.tfstate -var-file=$TFVARS -var name=$NAME vultr_instance.boost ${INSTANCE:-<instance id>}"
		step "state: encrypt it back to $STATE_AGE with age, commit hosts/vultr in the vault, remove the private directory"
		;;
	snapshot)
		STEPS=3
		echo "vultr-boost snapshot --dry-run: nothing below is run"
		step "state: open $STATE_AGE with age (read only) and read $NAME's id from it"
		step "ssh $(box_user)@<$NAME's address>: ask cloud-init status whether the bootstrap finished; a box whose bootstrap has not finished or ended in error is not snapshotted (nothing on the box changes)"
		step "curl -X POST $API/snapshots with the token on stdin: a snapshot of $NAME, whose id is printed for [cloud] snapshot"
		;;
	check)
		STEPS=2
		echo "vultr-boost check --dry-run: nothing below is run"
		step "ssh $HUB_SSH: read $NAME's address off /etc/wireguard/wg0.conf (nothing there changes)"
		step "ssh $(box_user)@<$NAME's address>: git fsck --connectivity-only on each checkout under its home, go mod verify in ~/millwright, count the EXT4-fs error lines of dmesg; print a \"fault = \" line for each thing wrong and a last \"check = \" line; a box whose cloud-init status is error is one \"fault = \" line and a failure, its disk not read (nothing on the box changes)"
		;;
	set-pace)
		STEPS=2
		echo "vultr-boost set-pace --dry-run: nothing below is run"
		step "ssh $HUB_SSH: read $NAME's address off /etc/wireguard/wg0.conf (nothing there changes)"
		step "ssh $(box_user)@<$NAME's address>: write ~/.config/systemd/user/mw-dispatch.timer.d/boost-pace.conf (OnCalendar= then OnCalendar=*:0/5) unless it is so, reload, restart mw-dispatch.timer and start one dispatch, then print the timer's OnCalendar"
		;;
	set-harness)
		STEPS=2
		echo "vultr-boost set-harness --dry-run: nothing below is run"
		step "ssh $HUB_SSH: read $NAME's address off /etc/wireguard/wg0.conf (nothing there changes)"
		step "ssh $(box_user)@<$NAME's address>: read claude --version; when it is behind ${VERSION:-<version>}, run npm install -g --prefix ~/.local @anthropic-ai/claude-code@${VERSION:-<version>} once and read claude --version again; print harness = <before> -> <after>, level, or stays: <why> (a failed install leaves the box up as it was)"
		;;
	set-session-deny)
		STEPS=2
		echo "vultr-boost set-session-deny --dry-run: nothing below is run"
		step "ssh $HUB_SSH: read $NAME's address off /etc/wireguard/wg0.conf (nothing there changes)"
		step "ssh $(box_user)@<$NAME's address>: set deny = ${DENY:-<rules>} in the [session] table of ~/.config/mw/config.toml (written whole and renamed into place, only if it changes); print session.deny = set or level"
		;;
	set-cap)
		STEPS=2
		echo "vultr-boost set-cap --dry-run: nothing below is run"
		step "ssh $HUB_SSH: read $NAME's address off /etc/wireguard/wg0.conf (nothing there changes)"
		step "ssh $(box_user)@<$NAME's address>: set cap = ${CAP:-<n>} in ~/.config/mw/config.toml (the first cap line of its root table, written whole and renamed into place)"
		;;
	address)
		STEPS=1
		echo "vultr-boost address --dry-run: nothing below is run"
		step "ssh $HUB_SSH: read $NAME's address off /etc/wireguard/wg0.conf (nothing there changes), and print it with the user $(box_user)"
		;;
	list)
		STEPS=1
		echo "vultr-boost list --dry-run: nothing below is run"
		step "curl $API/instances with the token on stdin: each instance's id, label, status and server status"
		;;
	spend)
		STEPS=1
		echo "vultr-boost spend --dry-run: nothing below is run"
		step "curl $API/billing/pending-charges with the token on stdin: the sum of the charges that name ${NAMES[*]:-$NAME}"
		;;
	status)
		STEPS=2
		echo "vultr-boost status --dry-run: nothing below is run"
		step "state: open $STATE_AGE with age (read only) and read the box's id from it"
		step "curl $API/instances/<id> with the token on stdin, and $API/plans for the price"
		;;
	esac
	exit 0
fi

# --- the private directory ----------------------------------------------------
PRIV=""
cleanup() {
	[ -z "$PRIV" ] || rm -rf "$PRIV"
	PRIV=""
}
trap cleanup EXIT
trap 'exit 130' INT TERM

open_priv() {
	[ -d "$RUNBASE" ] || die "$RUNBASE is not a directory: set VULTR_BOOST_RUN to a tmpfs directory (state is kept only in memory while terraform runs)"
	PRIV=$(mktemp -d "$RUNBASE/vultr-boost.XXXXXX")
	chmod 700 "$PRIV"
}

RECIPIENT=""
age_recipient() {
	[ -n "$RECIPIENT" ] || RECIPIENT=$(age-keygen -y "$AGE_KEY") || die "could not read the recipient from $AGE_KEY"
	echo "$RECIPIENT"
}

# open_state: the vault's encrypted state, as a plain file in the private directory (if any).
open_state() {
	[ -r "$AGE_KEY" ] || die "no age key at $AGE_KEY: this runs on the home, which holds it (docs/secrets.md)"
	open_priv
	if [ -f "$STATE_AGE" ]; then
		age -d -i "$AGE_KEY" "$STATE_AGE" >"$PRIV/terraform.tfstate" || die "could not decrypt $STATE_AGE with $AGE_KEY"
	fi
}

# seal_state: the private state back into the vault, encrypted, and committed.
seal_state() {
	local new
	if [ -s "$PRIV/terraform.tfstate" ]; then
		new=$STATE_AGE.new
		age -r "$(age_recipient)" -o "$new" <"$PRIV/terraform.tfstate" || die "could not encrypt the state"
		mv "$new" "$STATE_AGE"
	fi
	commit_vault "vultr-boost: $CMD"
}

commit_vault() {
	local files=() f
	for f in "$STATE_AGE" "$KEY_AGE" "$PUB_FILE"; do
		[ -f "$f" ] && files+=("$f")
	done
	[ ${#files[@]} -gt 0 ] || return 0
	if [ -z "$(git -C "$VAULT" status --porcelain -- "${files[@]}")" ]; then
		return 0
	fi
	git -C "$VAULT" add -- "${files[@]}" &&
		git -C "$VAULT" commit -q -m "$1" -- "${files[@]}" ||
		echo "vultr-boost: could not commit hosts/vultr in the vault; the files are there, commit them by hand" >&2
}

secret() { # name: the token kept under name; fails when none is kept
	mw secrets get "$1"
}

tf() { # terraform arguments: run in the tokens' environment, never their command line
	(
		export TF_VAR_vultr_api_key=$VULTR_KEY TF_VAR_wg_address=${WG_ADDRESS:-} TF_VAR_wg_hub_pubkey=${HUB_PUBKEY:-} \
			TF_VAR_wg_private_key=${WG_PRIVATE:-} TF_VAR_github_token=${GITHUB_TOKEN:-} \
			TF_VAR_claude_token=${CLAUDE_TOKEN:-} TF_VAR_beads_password=${BEADS_PASSWORD:-}
		exec terraform -chdir="$TFDIR" "$@"
	)
}

load_settings() {
	[ -f "$TFVARS" ] || die "no settings: write $TFVARS (docs/vultr-boost.md lists them)"
	local k
	for k in region wg_endpoint beads_host; do
		[ -n "$(tfvar $k)" ] || die "$TFVARS has no $k = \"...\" line"
	done
	case $NAME in
	*[!a-z0-9-]*) die "name \"$NAME\" in $TFVARS must match [a-z0-9-]+ (what wg-enrol accepts)" ;;
	esac
}

load_token() { # the Vultr token, required
	VULTR_KEY=$(secret vultr_api_token) || die "no vultr_api_token kept: mw secrets put vultr_api_token < token.txt (docs/secrets.md)"
	[ -n "$VULTR_KEY" ] || die "vultr_api_token is empty"
}

kept=""
load_optional_tokens() {
	kept=$(mw secrets list 2>/dev/null) || kept=""
	GITHUB_TOKEN="" CLAUDE_TOKEN="" BEADS_PASSWORD=""
	if echo "$kept" | grep -qx boost_github_token; then GITHUB_TOKEN=$(secret boost_github_token); else echo "    note: no boost_github_token kept; the box cannot clone the vault or rigs"; fi
	if echo "$kept" | grep -qx boost_claude_token; then CLAUDE_TOKEN=$(secret boost_claude_token); else echo "    note: no boost_claude_token kept; the box has no Claude login"; fi
	if echo "$kept" | grep -qx boost_beads_password; then BEADS_PASSWORD=$(secret boost_beads_password); fi
}

confirm_args() {
	if [ "$YES" = 1 ]; then echo "-auto-approve"; fi
}

snapshot_args() {
	if [ -n "$SNAPSHOT" ]; then echo "-var snapshot_id=$SNAPSHOT"; fi
}

# --- up -----------------------------------------------------------------------
do_up() {
	STEPS=6
	need mw terraform ssh age age-keygen wg git
	load_settings
	load_token
	step "read: settings and tokens"
	load_optional_tokens

	step "state: open the vault's"
	open_state

	step "wireguard: the box's key"
	mkdir -p "$HOSTDIR"
	if [ -f "$KEY_AGE" ]; then
		WG_PRIVATE=$(age -d -i "$AGE_KEY" "$KEY_AGE") || die "could not decrypt $KEY_AGE"
		echo "    skip: the key is already kept"
	else
		WG_PRIVATE=$(wg genkey)
		printf '%s\n' "$WG_PRIVATE" | age -r "$(age_recipient)" -o "$KEY_AGE" || die "could not encrypt the key"
		echo "    made: a new key, kept encrypted in hosts/vultr/wg.key.age"
	fi
	WG_PUBLIC=$(printf '%s\n' "$WG_PRIVATE" | wg pubkey)
	printf '%s\n' "$WG_PUBLIC" >"$PUB_FILE"
	commit_vault "vultr-boost: key for $NAME"

	step "hub: enrol $NAME on $HUB_SSH"
	local remote out backup
	remote="set -e; f=/etc/wireguard/wg0.conf; if grep -q '^# peer $NAME (enrolled' \"\$f\"; then echo backup:none; else b=\$f.bak-\$(date +%Y%m%d%H%M%S); cp -p \"\$f\" \"\$b\"; echo backup:\$b; fi; $ENROL $NAME $WG_PUBLIC"
	out=$(hubssh "$remote") || die "could not enrol $NAME on the hub ($HUB_SSH); the box was not made"
	backup=$(echo "$out" | sed -n 's/^backup://p' | head -n 1)
	WG_ADDRESS=$(echo "$out" | sed -n 's/^Address = \([0-9.]*\)\/.*/\1/p' | head -n 1)
	HUB_PUBKEY=$(echo "$out" | awk '/^\[Peer\]/ { p = 1 } p && /^PublicKey = / { print $3; exit }')
	if [ -z "$WG_ADDRESS" ] || [ -z "$HUB_PUBKEY" ]; then
		die "the hub's answer had no address or key for $NAME; its wg0.conf is as it was unless backup $backup says otherwise"
	fi
	if [ "$backup" = none ]; then
		echo "    skip: $NAME is already a peer of the hub ($WG_ADDRESS); nothing changed there"
	else
		echo "    enrolled: $NAME is $WG_ADDRESS on the hub; its old wg0.conf is $backup"
	fi
	echo "    way back: ssh $HUB_SSH '$ENROL --remove $NAME'    (or restore $backup and run: wg syncconf wg0 <(wg-quick strip wg0))"

	step "terraform: init, then apply (this is where the box starts to cost money)"
	cost_line
	tf init -input=false >/dev/null || die "terraform init failed"
	local rc=0
	# shellcheck disable=SC2046
	tf apply -state="$PRIV/terraform.tfstate" -var-file="$TFVARS" -var "name=$NAME" $(snapshot_args) $(confirm_args) || rc=$?

	step "state: seal it in the vault"
	seal_state
	[ "$rc" = 0 ] || die "terraform apply failed (status $rc). The peer is on the hub; the state is kept; run up again, or down to remove both"
	echo "    up. watch it with: contrib/vultr-boost status   (the bootstrap takes some minutes; its log is ~/boost-bootstrap.log on the box)"
}

# --- down ---------------------------------------------------------------------
# forget_host ADDR: drop ADDR's lines from ~/.ssh/known_hosts (hashed or not), so
# the box next given the address is reached without REMOTE HOST IDENTIFICATION
# HAS CHANGED (mw-5gr3k0.7).
forget_host() {
	local known=$HOME/.ssh/known_hosts
	case $1 in
	"" | *[!0-9.]*)
		echo "    skip: the hub gave no address for $NAME, so ~/.ssh/known_hosts is left as it is"
		return 0
		;;
	esac
	if [ ! -f "$known" ]; then
		echo "    skip: there is no ~/.ssh/known_hosts to drop $1 from"
	elif ! command -v ssh-keygen >/dev/null 2>&1; then
		echo "    note: ssh-keygen is not installed; drop $1 from ~/.ssh/known_hosts by hand (ssh-keygen -R $1)"
	elif ! ssh-keygen -F "$1" -f "$known" >/dev/null 2>&1; then
		echo "    skip: $1 is not in ~/.ssh/known_hosts"
	elif ssh-keygen -R "$1" -f "$known" >/dev/null 2>&1; then
		echo "    forgot: $1 in ~/.ssh/known_hosts (the box next given it has a new host key); the old file is known_hosts.old"
	else
		echo "    note: ssh-keygen -R $1 failed; drop it from ~/.ssh/known_hosts by hand"
	fi
}

do_down() {
	STEPS=4
	need mw terraform ssh age age-keygen git jq curl
	load_settings
	load_token

	step "state: open the vault's"
	open_state

	step "terraform: destroy"
	local rc=0 why held=""
	if [ -s "$PRIV/terraform.tfstate" ]; then
		tf init -input=false >/dev/null || die "terraform init failed"
		# shellcheck disable=SC2046
		tf destroy -state="$PRIV/terraform.tfstate" -var-file="$TFVARS" -var "name=$NAME" $(confirm_args) || rc=$?
	else
		echo "    skip: no state in the vault, so terraform destroyed nothing (a box Vultr holds is deleted by --instance ID)"
		if [ -z "$INSTANCE" ]; then
			# Vultr may still hold the box (its make was killed, or its state lost, or
			# it is restoring from a snapshot): its peer stays on the hub until the
			# instance is deleted by its id, which takes the peer off (mw-gq6.1226).
			vultr_api GET "/instances?per_page=500" ||
				die "no state in the vault for $NAME, and Vultr's list of instances could not be read (HTTP $API_CODE), so whether Vultr still holds it is not known. The peer was left on the hub. Run down again"
			held=$(printf '%s' "$API_BODY" | jq -r --arg n "$NAME" '[.instances[]? | select(.label == $n) | .id][0] // empty') ||
				die "Vultr's list of instances could not be read, so whether Vultr still holds $NAME is not known. The peer was left on the hub. Run down again"
		fi
	fi
	if [ "$rc" != 0 ]; then
		seal_state
		die "terraform destroy failed (status $rc); the peer was left on the hub and the state is kept. Run down again"
	fi
	if [ -n "$INSTANCE" ]; then
		# An orphan: a box terraform made and lost the state of. Terraform's destroy
		# above may have taken it (or found nothing), so a 404 is done.
		if vultr_api DELETE "/instances/$INSTANCE"; then
			case $API_CODE in
			404) echo "    skip: Vultr holds no instance $INSTANCE" ;;
			*) echo "    deleted: Vultr instance $INSTANCE, no state held it" ;;
			esac
		else
			seal_state
			why="HTTP $API_CODE"
			# Vultr locks an instance it is restoring from a snapshot, and says 409.
			[ "$API_CODE" != 409 ] || why="locked, HTTP 409"
			die "Vultr would not delete instance $INSTANCE ($why): $(printf '%s' "$API_BODY" | tr '\n' ' ' | cut -c1-300). The peer was left on the hub. Run down again"
		fi
	fi

	step "hub: remove $NAME from $HUB_SSH"
	if [ -n "$held" ]; then
		echo "    skip: Vultr still holds instance $held labelled $NAME, so its peer stays on the hub; down --name $NAME --instance $held deletes it and takes the peer off"
		seal_state
		echo "    not down: Vultr instance $held is still held, and billed."
		return 0
	fi
	local remote out backup addr
	# The peer's address is read before it goes: the next box given it has a new host key.
	remote="set -e; f=/etc/wireguard/wg0.conf; if grep -q '^# peer $NAME (enrolled' \"\$f\"; then echo addr:\$(sed -n '/^# peer $NAME (enrolled/,/^AllowedIPs/ s#^AllowedIPs = \([0-9.]*\)/32.*#\1#p' \"\$f\" | head -n 1); b=\$f.bak-\$(date +%Y%m%d%H%M%S); cp -p \"\$f\" \"\$b\"; echo backup:\$b; $ENROL --remove $NAME; else echo backup:none; fi"
	if out=$(hubssh "$remote"); then
		backup=$(echo "$out" | sed -n 's/^backup://p' | head -n 1)
		addr=$(echo "$out" | sed -n 's/^addr://p' | head -n 1)
		if [ "$backup" = none ]; then
			echo "    skip: $NAME is not a peer of the hub"
		else
			echo "    removed: $NAME is off the hub; its old wg0.conf is $backup"
			echo "    way back: ssh $HUB_SSH 'cp -p $backup /etc/wireguard/wg0.conf' and then wg syncconf wg0 <(wg-quick strip wg0) there"
			forget_host "$addr"
		fi
	else
		echo "vultr-boost: the box is destroyed, but the peer could not be removed from $HUB_SSH: run it there: $ENROL --remove $NAME" >&2
		rc=1
	fi

	step "state: seal it in the vault"
	seal_state
	[ "$rc" = 0 ] || exit 1
	echo "    down. nothing of this box is running or billed."
}

# --- adopt ---------------------------------------------------------------------
# adopt: a Vultr instance the box's make was cut off from, into the box's state.
do_adopt() {
	STEPS=3
	need mw terraform age age-keygen git
	[ -n "$INSTANCE" ] || die "adopt needs --instance ID: the Vultr instance to take into $NAME's state"
	load_settings
	load_token
	step "state: open the vault's"
	open_state
	if grep -q "\"id\": *\"$INSTANCE\"" "$PRIV/terraform.tfstate" 2>/dev/null; then
		echo "    skip: the state already holds $INSTANCE"
		return 0
	fi
	step "terraform: import vultr_instance.boost $INSTANCE"
	local rc=0
	tf init -input=false >/dev/null || die "terraform init failed"
	# shellcheck disable=SC2046
	tf import -input=false -state="$PRIV/terraform.tfstate" -var-file="$TFVARS" -var "name=$NAME" $(snapshot_args) vultr_instance.boost "$INSTANCE" || rc=$?
	step "state: seal it in the vault"
	seal_state
	[ "$rc" = 0 ] || die "terraform import failed (status $rc)"
	echo "    adopted: $INSTANCE is $NAME's in the state; down will find it"
}

# --- status -------------------------------------------------------------------
# plan_cost: "monthly hourly" of the plan, from Vultr's public price list.
plan_cost() {
	local plan=${1:-vhp-8c-16gb-amd}
	curl -fsS "$API/plans?type=vhp&per_page=500" 2>/dev/null |
		jq -r --arg p "$plan" '.plans[] | select(.id == $p) | "\(.monthly_cost) \(.hourly_cost)"' 2>/dev/null | head -n 1
}

cost_line() {
	local plan c
	plan=$(tfvar plan)
	c=$(plan_cost "${plan:-vhp-8c-16gb-amd}" || true)
	if [ -n "$c" ]; then
		echo "    cost: \$${c% *} a month, \$${c#* } an hour, for as long as the box exists (stopped boxes bill too); contrib/vultr-boost down ends it"
	else
		echo "    cost: Vultr's price list could not be read; High Performance 8 vCPU / 16 GB is about \$96 a month"
	fi
}

do_status() {
	STEPS=2
	need age jq curl
	step "state: read the vault's"
	local id plan created c
	if [ -f "$STATE_AGE" ]; then
		[ -r "$AGE_KEY" ] || die "no age key at $AGE_KEY: this runs on the home, which holds it (docs/secrets.md)"
		open_priv
		age -d -i "$AGE_KEY" "$STATE_AGE" >"$PRIV/terraform.tfstate" || die "could not decrypt $STATE_AGE"
		id=$(jq -r '[.resources[]? | select(.type == "vultr_instance") | .instances[0].attributes.id][0] // empty' "$PRIV/terraform.tfstate")
		plan=$(jq -r '[.resources[]? | select(.type == "vultr_instance") | .instances[0].attributes.plan][0] // empty' "$PRIV/terraform.tfstate")
		created=$(jq -r '[.resources[]? | select(.type == "vultr_instance") | .instances[0].attributes.date_created][0] // empty' "$PRIV/terraform.tfstate")
	fi
	if [ -z "${id:-}" ]; then
		c=$(plan_cost "" || true)
		echo "    no box: nothing is running or billed."
		[ -z "$c" ] || echo "    a box would cost \$${c% *} a month (\$${c#* } an hour) while it exists."
		return 0
	fi
	step "vultr: ask for $id"
	local token reply
	token=$(secret vultr_api_token) || die "no vultr_api_token kept: mw secrets put vultr_api_token < token.txt"
	reply=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -fsS -K - "$API/instances/$id") || reply=""
	echo "    box:    $id ($NAME), plan ${plan:-unknown}"
	if [ -n "$reply" ]; then
		echo "    state:  $(echo "$reply" | jq -r '.instance | "\(.status), \(.power_status), server \(.server_status)"')"
	else
		echo "    state:  unknown (Vultr's API could not be reached, or the box is gone from it)"
	fi
	c=$(plan_cost "$plan" || true)
	if [ -n "$c" ]; then
		echo "    cost:   \$${c% *} a month, \$${c#* } an hour"
		if [ -n "$created" ]; then
			local then_s now_s
			then_s=$(date -d "$created" +%s 2>/dev/null || echo "")
			now_s=$(date +%s)
			if [ -n "$then_s" ]; then
				awk -v h="${c#* }" -v t="$then_s" -v n="$now_s" 'BEGIN { hrs = (n - t) / 3600; printf "    so far: about $%.2f over %.1f hours since it was made\n", hrs * h, hrs }'
			fi
		fi
	else
		echo "    cost:   Vultr's price list could not be read"
	fi
}

# --- snapshot -----------------------------------------------------------------
# box_id: the id of the box in the vault's state for NAME, or nothing. The
# private directory is opened first, by the caller, so the trap removes it.
box_id() {
	[ -f "$STATE_AGE" ] || return 0
	[ -r "$AGE_KEY" ] || die "no age key at $AGE_KEY: this runs on the home, which holds it (docs/secrets.md)"
	age -d -i "$AGE_KEY" "$STATE_AGE" >"$PRIV/terraform.tfstate" || die "could not decrypt $STATE_AGE"
	jq -r '[.resources[]? | select(.type == "vultr_instance") | .instances[0].attributes.id][0] // empty' "$PRIV/terraform.tfstate"
	rm -f "$PRIV/terraform.tfstate"
}

do_snapshot() {
	STEPS=3
	need mw age jq curl ssh
	step "state: read $NAME's id from the vault's"
	local id token reply snap rc=0
	open_priv
	id=$(box_id)
	[ -n "$id" ] || die "no box $NAME in the vault's state: make one with up --name $NAME, let it bootstrap, then snapshot it"
	step "box: ask whether $NAME's bootstrap finished"
	box_address "$NAME"
	ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$(box_user)@$ADDR" "sh -s" <<<"$BOX_BOOTSTRAP" >/dev/null || rc=$?
	bootstrap_refused "$rc" "$(box_user)@$ADDR" "snapshotted"
	[ "$rc" = 0 ] || die "could not ask $NAME whether its bootstrap finished ($(box_user)@$ADDR)"
	step "vultr: snapshot $id"
	token=$(secret vultr_api_token) || die "no vultr_api_token kept: mw secrets put vultr_api_token < token.txt"
	reply=$(printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$token" |
		curl -fsS -K - -X POST --data "{\"instance_id\":\"$id\",\"description\":\"mw boost $NAME $(date -u +%Y-%m-%d)\"}" "$API/snapshots") ||
		die "Vultr would not snapshot $id"
	snap=$(echo "$reply" | jq -r '.snapshot.id // empty')
	[ -n "$snap" ] || die "Vultr's answer named no snapshot"
	echo "    snapshot: $snap (Vultr takes some minutes to finish it; it bills for its size while kept)"
	echo "    put it in ~/.config/mw/config.toml: [cloud] snapshot = \"$snap\""
}

# --- list -----------------------------------------------------------------------
# vultr_api METHOD PATH: call Vultr with the token on curl's stdin. API_BODY and
# API_CODE are its answer; it succeeds on a 2xx, or on a 204 or 404 of a DELETE
# (the only two answers that say an instance is gone), and says on standard error
# what Vultr said when it does not.
API_BODY=""
API_CODE=""
vultr_api() {
	local method=$1 reply
	reply=$(printf 'header = "Authorization: Bearer %s"\n' "$VULTR_KEY" | curl -sS -m 60 -K - -X "$method" -w '\n%{http_code}' "$API$2") || {
		API_BODY="" API_CODE=000
		echo "vultr-boost: could not reach Vultr ($method $2)" >&2
		return 1
	}
	API_CODE=${reply##*$'\n'}
	API_BODY=${reply%$'\n'*}
	if [ "$method" = DELETE ]; then
		case $API_CODE in
		204 | 404) return 0 ;;
		*) return 1 ;;
		esac
	fi
	case $API_CODE in
	2??) ;;
	*) return 1 ;;
	esac
}

# list: each instance Vultr holds, "id<TAB>label<TAB>status". A refusal is said,
# as Vultr said it, on standard error.
do_list() {
	need mw jq curl
	load_token
	vultr_api GET "/instances?per_page=500" || {
		echo "vultr-boost: Vultr refused the list of instances (HTTP $API_CODE): $(printf '%s' "$API_BODY" | tr '\n' ' ' | cut -c1-300)" >&2
		exit 1
	}
	printf '%s' "$API_BODY" | jq -r '.instances[]? | [.id, (.label // ""), (.status // ""), (.server_status // "")] | @tsv'
}

# --- spend ----------------------------------------------------------------------
# spend: the pending charges this month whose description names a box, summed;
# "unknown" when Vultr's billing could not be read or said nothing to sum.
do_spend() {
	need mw jq curl
	local token reply names usd
	[ ${#NAMES[@]} -gt 0 ] || NAMES=("$NAME")
	token=$(secret vultr_api_token 2>/dev/null) || {
		echo unknown
		return 0
	}
	reply=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -fsS -m 30 -K - "$API/billing/pending-charges" 2>/dev/null) || {
		echo unknown
		return 0
	}
	names=$(printf '%s\n' "${NAMES[@]}" | jq -R . | jq -s .)
	usd=$(echo "$reply" | jq -r --argjson names "$names" '
		if (.pending_charges | type) != "array" then empty else
		[.pending_charges[] | select(((.description // "") + " " + (.product // "")) as $d | any($names[]; . as $n | $d | test("\\b" + $n + "\\b")))
			| (.total // .amount // 0) | tonumber] | add // 0 end' 2>/dev/null) || usd=""
	if [ -z "$usd" ]; then
		echo unknown
	else
		printf '%.2f\n' "$usd"
	fi
}

# --- set-cap --------------------------------------------------------------------
# The rewrite run on the box: the first `cap` line of the root table of the box's
# config, or a new one before the first table; every other line as it was. $1 is the cap.
BOX_SET_CAP='set -e; f=$HOME/.config/mw/config.toml; [ -f "$f" ] || { echo "no $f on this box" >&2; exit 3; }
t=$f.new.$$; trap "rm -f $t" EXIT
awk -v n="$1" '"'"'
	!done && /^[[:space:]]*\[/ { if (!set) print "cap = " n; done = 1 }
	!done && /^[[:space:]]*cap[[:space:]]*=/ { if (!set) print "cap = " n; set = 1; next }
	{ print }
	END { if (!done && !set) print "cap = " n }
'"'"' "$f" >"$t"
mv "$t" "$f"; trap - EXIT; echo "cap = $1"'

# box_address NAME: the WireGuard address of NAME off the hub's wg0.conf (nothing there
# changes), in ADDR; dies when the hub cannot be read or NAME is no peer of it.
box_address() {
	local out
	out=$(hubssh "sed -n '/^# peer $1 (enrolled/,/^AllowedIPs/ s#^AllowedIPs = \([0-9.]*\)/32.*#\1#p' /etc/wireguard/wg0.conf | head -n 1") || die "could not read $1's address off the hub ($HUB_SSH)"
	ADDR=$(echo "$out" | head -n 1)
	case $ADDR in
	"" | *[!0-9.]*) die "$1 is not a peer of the hub: it has no address" ;;
	esac
}

do_set_cap() {
	need ssh
	[ -n "$CAP" ] && [ "$CAP" -ge 1 ] || die "set-cap needs --cap N, a whole number of sessions, 1 or more"
	[ -n "$NAME_ARG" ] || die "set-cap needs --name NAME: the box to set the cap on"
	STEPS=2
	local out
	step "hub: read $NAME's address off $HUB_SSH"
	box_address "$NAME"
	local addr=$ADDR
	step "box: set cap = $CAP on $(box_user)@$addr"
	out=$(ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$(box_user)@$addr" "sh -s -- $CAP" <<<"$BOX_SET_CAP") || die "could not set the cap on $NAME ($(box_user)@$addr)"
	echo "    $NAME: $out in ~/.config/mw/config.toml; its next dispatch reads it, sessions running are not touched"
}

# --- set-pace -------------------------------------------------------------------
# The run on the box: the timer drop-in of boost-bootstrap.sh's step 13, written when the
# box's is not that text (then systemd reloaded, the timer restarted and one dispatch started,
# as the bootstrap does), and the OnCalendar the timer ends with: the last one after the last
# empty OnCalendar= that clears those before it.
BOX_SET_PACE='set -e; export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
d=$HOME/.config/systemd/user/mw-dispatch.timer.d; f=$d/boost-pace.conf
want="[Timer]
OnCalendar=
OnCalendar=*:0/5"
if [ "$(cat "$f" 2>/dev/null)" != "$want" ]; then
	mkdir -p "$d"; t=$f.new.$$; trap "rm -f $t" EXIT
	printf "%s\n" "$want" >"$t"; chmod 644 "$t"; mv "$t" "$f"; trap - EXIT
	systemctl --user daemon-reload
	systemctl --user restart mw-dispatch.timer
	systemctl --user start --no-block mw-dispatch.service
fi
systemctl --user cat mw-dispatch.timer | awk -F= '"'"'/^OnCalendar=/ { last = $2 } END { print "pace = " last }'"'"

do_set_pace() {
	need ssh
	[ -n "$NAME_ARG" ] || die "set-pace needs --name NAME: the box to set the dispatch timer of"
	STEPS=2
	local out
	step "hub: read $NAME's address off $HUB_SSH"
	box_address "$NAME"
	local addr=$ADDR
	step "box: dispatch timer every five minutes on $(box_user)@$addr"
	out=$(ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$(box_user)@$addr" "sh -s" <<<"$BOX_SET_PACE") || die "could not set the dispatch timer on $NAME ($(box_user)@$addr)"
	echo "$out"
}

# --- check ----------------------------------------------------------------------
# The run on the box. It only reads: git fsck writes nothing, go mod verify reads the module
# cache, dmesg is read with sudo when the box's user may not. A checkout is a directory under
# the home with a .git directory (a story's worktree has a .git file, and is its rig's). The
# vault and the millwright checkout must be there: a box without them is not sound. Every
# fault is one line, and the last line says the check ran to its end. A box whose bootstrap
# (cloud-init) has not finished gives no verdict: a snapshot can carry a checkout the bootstrap
# mends (mw-5gr3k0.8), and the check is asked again. A box whose bootstrap ended in error is a
# fault before the disk is read, and the run ends there with BOX_CHECK_BOOTSTRAP_ERROR: cloud6's
# died at step 10 of 13, and a box like it, the steps after that never run, is not to be cleared
# on a disk that reads well (mw-gq6.1189). A checkout git cannot walk is walked once
# more after three seconds, so that a fetch or a repack under way is not read as a fault.
# Last, every file under the home of 4096 bytes or more that has not changed since this boot
# (the snapshot's own) is opened, and one that begins with a whole block of zeros is a fault:
# cloud6 came up on 2026-11-13 with every file above 314 GiB of its 350 GiB disk reading zero,
# the restore not having written the end of the disk, and passed the three checks above. Go's
# and the rigs' testdata directories hold files that are zeros by design, and are left out.
BOX_BOOTSTRAP_PENDING=75
BOX_BOOTSTRAP_ERROR=76
# BOX_BOOTSTRAP is the one reader of the bootstrap's verdict, run on the box by check (as the
# head of BOX_CHECK) and by snapshot: cloud-init's status is running or not yet (exit 75, and
# the box says so on standard error), error (a "fault = " line and exit 76), or done, or no
# cloud-init on the box (exit 0, and the caller goes on). bootstrap_refused is its reader on
# the home, for the two that stop the caller (mw-gq6.1282).
BOX_BOOTSTRAP='export PATH=$HOME/.local/bin:$HOME/.local/go/bin:/usr/local/go/bin:$PATH
boot=$(command -v cloud-init >/dev/null 2>&1 && cloud-init status 2>/dev/null)
if printf "%s\n" "$boot" | grep -q "^status: \(running\|not\)"; then
	echo "the bootstrap of this box (cloud-init) has not finished" >&2
	exit '"$BOX_BOOTSTRAP_PENDING"'
fi
if printf "%s\n" "$boot" | grep -q "^status: error"; then
	echo "fault = cloud-init: the bootstrap ended in error (cloud-init status says error), so the box is not whole whatever its disk reads: its log is ~/boost-bootstrap.log on the box"
	exit '"$BOX_BOOTSTRAP_ERROR"'
fi
'
BOX_CHECK=$BOX_BOOTSTRAP'n=0
last() { printf "%s\n" "$1" | grep . | tail -n 1 | cut -c1-200; }
walk() { git --git-dir="$1/.git" --work-tree="$1" fsck --connectivity-only --no-progress 2>&1 >/dev/null; }
for g in "$HOME"/*/.git; do
	[ -d "$g" ] || continue
	d=${g%/.git}; n=$((n + 1))
	if ! out=$(walk "$d"); then
		sleep 3
		if ! out=$(walk "$d"); then
			echo "fault = ~/${d##*/}: git fsck: $(last "$out")"
		fi
	fi
done
[ -d "$HOME/millwright-vault/.git" ] || echo "fault = ~/millwright-vault: no vault checkout to check"
if [ -d "$HOME/millwright/.git" ]; then
	if ! out=$(cd "$HOME/millwright" && go mod verify 2>&1); then
		echo "fault = ~/millwright: go mod verify: $(last "$out")"
	fi
else
	echo "fault = ~/millwright: no checkout to run go mod verify in"
fi
if log=$(sudo -n dmesg 2>/dev/null) || log=$(dmesg 2>/dev/null); then
	c=$(printf "%s\n" "$log" | grep -c "EXT4-fs error")
	[ "$c" = 0 ] || echo "fault = dmesg: $c lines of EXT4-fs error, the last: $(last "$(printf "%s\n" "$log" | grep "EXT4-fs error")")"
else
	echo "fault = dmesg: the kernel log could not be read"
fi
if scan=$(nice -n 10 python3 - "$HOME" 2>&1 <<"PY"
import os, sys, time
home = sys.argv[1]
boot = time.time() - float(open("/proc/uptime").read().split()[0])
seen = 0
zero = []
for root, dirs, files in os.walk(home):
    if "/testdata/" in root + "/":
        continue
    for name in files:
        path = os.path.join(root, name)
        try:
            st = os.lstat(path)
            if st.st_size < 4096 or (st.st_mode & 0o170000) != 0o100000 or st.st_mtime >= boot:
                continue
            seen += 1
            with open(path, "rb") as f:
                if f.read(4096).strip(b"\0"):
                    continue
            zero.append(path.replace(home, "~", 1))
        except OSError:
            pass
print(seen)
print(len(zero))
print(zero[0] if zero else "")
PY
); then
	z=$(printf "%s\n" "$scan" | sed -n 2p)
	[ "$z" = 0 ] || echo "fault = $z of the $(printf "%s\n" "$scan" | sed -n 1p) files older than this boot begin with a block of zeros, the first: $(printf "%s\n" "$scan" | sed -n 3p | cut -c1-160): the snapshot restore did not write the whole disk"
else
	echo "fault = the scan for zero-filled files could not run: $(last "$scan")"
fi
echo "check = $n checkouts (git fsck --connectivity-only), go mod verify in ~/millwright, EXT4-fs errors in dmesg, zero-filled files older than this boot"'

# bootstrap_refused RC BOX WHAT: dies when RC, the exit of BOX_BOOTSTRAP's run on BOX, says the
# bootstrap has not finished or ended in error; WHAT is what the box is not (cleared, snapshotted).
bootstrap_refused() {
	case $1 in
	"$BOX_BOOTSTRAP_PENDING") die "$NAME's bootstrap (cloud-init) has not finished, so it is not $3: ask again once it has" ;;
	"$BOX_BOOTSTRAP_ERROR") die "$NAME's bootstrap ended in error (cloud-init status), so it is not $3: its log is ~/boost-bootstrap.log on $2; to destroy the box: mw cloud down $NAME" ;;
	esac
}

do_check() {
	need ssh
	[ -n "$NAME_ARG" ] || die "check needs --name NAME: the box to check the disk of"
	STEPS=2
	local out rc=0
	step "hub: read $NAME's address off $HUB_SSH"
	box_address "$NAME"
	local addr=$ADDR
	step "box: check the disk of $(box_user)@$addr (git fsck, go mod verify, dmesg)"
	out=$(ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$(box_user)@$addr" "sh -s" <<<"$BOX_CHECK") || rc=$?
	# The box was asked and its answer is its bootstrap's, and the command fails so that no
	# reader takes the box for cleared; its fault line is printed first.
	[ "$rc" != "$BOX_BOOTSTRAP_ERROR" ] || echo "$out"
	bootstrap_refused "$rc" "$(box_user)@$addr" "cleared and its disk was not read"
	[ "$rc" = 0 ] || die "could not ask $NAME to check its disk ($(box_user)@$addr)"
	echo "$out"
}

# --- set-harness ----------------------------------------------------------------
# The run on the box: $1 is the version wanted. The harness npm installs under the box's prefix
# ~/.local (npm's own prefix on a box is the node folder, so a bare -g puts a copy where PATH never
# reaches); ~/.local/bin is put on PATH here because a non-interactive ssh has not got it. A
# box at $1 or later is left alone; any failure of the install is a "stays" line, and the script
# exits 0, so the bring-up goes on with the box on the version it had.
BOX_SET_HARNESS='export PATH=$HOME/.local/bin:$PATH; want=$1
have() { claude --version 2>/dev/null | awk '"'"'{ print $1; exit }'"'"'; }
was=$(have); [ -n "$was" ] || was=none
if [ "$was" != none ] && [ "$(printf "%s\n%s\n" "$was" "$want" | sort -V | tail -n 1)" = "$was" ]; then
	echo "harness = $was level"; exit 0
fi
if ! out=$(npm install -g --prefix "$HOME/.local" "@anthropic-ai/claude-code@$want" 2>&1); then
	echo "harness = $was stays: npm install failed: $(printf "%s\n" "$out" | grep -v "^npm warn" | tail -n 1)"; exit 0
fi
now=$(have); [ -n "$now" ] || now=none
if [ "$now" = "$want" ]; then echo "harness = $was -> $now"
else echo "harness = $was stays: after the install claude --version says $now, not $want"; fi'

do_set_harness() {
	need ssh
	[ -n "$NAME_ARG" ] || die "set-harness needs --name NAME: the box to bring the harness of up to date"
	case $VERSION in
	"" | *[!0-9.]* | .* | *. | *..*) die "set-harness needs --version VERSION, numbers and dots (as mw version prints the harness's), not '$VERSION'" ;;
	esac
	STEPS=2
	local out
	step "hub: read $NAME's address off $HUB_SSH"
	box_address "$NAME"
	local addr=$ADDR
	step "box: Claude Code to $VERSION on $(box_user)@$addr"
	out=$(ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$(box_user)@$addr" "sh -s -- $VERSION" <<<"$BOX_SET_HARNESS") || die "could not reach $NAME ($(box_user)@$addr) to read its Claude Code"
	echo "$out"
}

# --- set-session-deny -----------------------------------------------------------
# The rewrite run on the box: $1 is the rules as a base64 of the one-line array (so that no quote
# or backslash of a rule meets a shell on the way). The `deny` line of the config's [session]
# table is replaced (its continuation lines, if it was written over several, dropped), or added to
# that table, or a [session] table is added at the end; every other line as it was. The line is
# handed to awk in the environment, which awk does not read escapes in. A file that would not change
# is left alone.
BOX_SET_SESSION_DENY='set -e; f=$HOME/.config/mw/config.toml; [ -f "$f" ] || { echo "no $f on this box" >&2; exit 3; }
LINE="deny = $(printf "%s" "$1" | base64 -d)"; export LINE
t=$f.new.$$; trap "rm -f $t" EXIT
awk '"'"'
	function closed(s) { sub(/[[:space:]]*#[^"]*$/, "", s); return s ~ /\][[:space:]]*$/ }
	function blanks_out() { while (blanks > 0) { print ""; blanks-- } }
	function end_session() { if (in_session && !set) { print ENVIRON["LINE"]; set = 1 } blanks_out() }
	skip { if (closed($0)) skip = 0; next }
	/^[[:space:]]*\[/ {
		end_session()
		in_session = ($0 ~ /^[[:space:]]*\[session\][[:space:]]*(#.*)?$/); if (in_session) seen = 1
		print; next
	}
	in_session && /^[[:space:]]*$/ { blanks++; next }
	in_session && /^[[:space:]]*deny[[:space:]]*=/ {
		blanks_out()
		if (!set) print ENVIRON["LINE"]
		set = 1
		v = $0; sub(/^[^=]*=/, "", v); if (!closed(v)) skip = 1
		next
	}
	{ blanks_out(); print }
	END {
		end_session()
		if (!seen) { print ""; print "[session]"; print ENVIRON["LINE"] }
	}
'"'"' "$f" >"$t"
if cmp -s "$f" "$t"; then rm -f "$t"; trap - EXIT; echo "session.deny = level"; exit 0; fi
chmod --reference="$f" "$t"; mv "$t" "$f"; trap - EXIT; echo "session.deny = set"'

do_set_session_deny() {
	need ssh
	[ -n "$NAME_ARG" ] || die "set-session-deny needs --name NAME: the box to set the session deny list of"
	case $DENY in
	"["*"]") ;;
	*) die "set-session-deny needs --deny '[\"rule\", ...]', a one-line TOML array of strings, not '$DENY'" ;;
	esac
	case $DENY in *$'\n'*) die "set-session-deny needs --deny on one line" ;; esac
	STEPS=2
	local out b64
	b64=$(printf '%s' "$DENY" | base64 -w0)
	step "hub: read $NAME's address off $HUB_SSH"
	box_address "$NAME"
	local addr=$ADDR
	step "box: session deny list on $(box_user)@$addr"
	out=$(ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$(box_user)@$addr" "sh -s -- '$b64'" <<<"$BOX_SET_SESSION_DENY") || die "could not set the session deny list on $NAME ($(box_user)@$addr)"
	echo "$out"
}

# address prints the address and then the user, nothing else on standard output.
do_address() {
	need ssh
	[ -n "$NAME_ARG" ] || die "address needs --name NAME: the box to read the address of"
	box_address "$NAME"
	echo "$ADDR"
	box_user
}

case $CMD in
up) do_up ;;
down) do_down ;;
list) do_list ;;
adopt) do_adopt ;;
status) do_status ;;
snapshot) do_snapshot ;;
spend) do_spend ;;
set-cap) do_set_cap ;;
set-pace) do_set_pace ;;
check) do_check ;;
set-harness) do_set_harness ;;
set-session-deny) do_set_session_deny ;;
address) do_address ;;
esac
