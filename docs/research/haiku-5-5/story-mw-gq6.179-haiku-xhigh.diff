+// The typed count is the new messages, never the inbox's total: with 233
+// listed and 231 of them already announced, the line says 2.
+func TestTheTypedCountIsTheNewMessagesNotTheWholeInbox(t *testing.T) {
+	f := newFactory(t)
+	f.mayor("idle", actingByID)
+	var old []string
+	for i := range 231 {
+		old = append(old, fmt.Sprintf("mw-old%03d", i))
+	}
+	f.write("state/announced", strings.Join(old, "\n")+"\n", 0o644)
+	f.inbox(append(old, "mw-new1", "mw-new2")...)
+
+	f.tick()
+
+	f.typed(fmt.Sprintf(announcement, 2))
+}
